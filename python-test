                "avg":      round(av_cpu   or 0, 1),
                "freq_mhz": round(cpu_freq or 0, 0),
                "temp_c":   round(cpu_temp or 0, 1),
                "top":      [{"name": r[0], "cpu": r[1] or 0, "mem_mb": r[2] or 0,
                              "gpu_mb": r[3] or 0, "inst": r[4] or 1}
                             for r in top_cpu],
            },
            "ram": {
                "pct":      round(ram_pct  or 0, 1),
                "used_mb":  ram_used or 0,
                "total_mb": ram_tot  or 0,
                "peak":     round(mk_ram   or 0, 1),
