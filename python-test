# ─────────────────────────────────────────────────────────────────────────────
#  Atomic write helpers
# ─────────────────────────────────────────────────────────────────────────────

def _tmp_path(dest: Path) -> Path:
    """
    Return a unique sibling .tmp path for *dest*.
    Uses PID + monotonic counter so concurrent writers never collide.
    """
    global _TMP_COUNTER
    _TMP_COUNTER += 1
    return dest.with_name(f"{dest.name}.{os.getpid()}_{_TMP_COUNTER}.tmp")


def _atomic_write_text(dest: Path, content: str, encoding: str = "utf-8") -> bool:
    """
    Write text to *dest* atomically via a uniquely-named sibling .tmp file.

    Steps:  write tmp  →  os.replace(tmp, dest)  →  True
    On any failure:  delete tmp (best-effort)  →  return False (never raise)

    ENOSPC (disk full) is caught explicitly and logged at WARNING level
    so it stands out from ordinary permission errors.
    """
    tmp = _tmp_path(dest)
    try:
        tmp.write_text(content, encoding=encoding)
        os.replace(tmp, dest)
        return True
    except OSError as exc:
        _cleanup_tmp(tmp, exc)
        return False


def _atomic_write_bytes(dest: Path, data: bytes) -> bool:
    """Binary version of _atomic_write_text.  Same semantics."""
    tmp = _tmp_path(dest)
    try:
        tmp.write_bytes(data)
        os.replace(tmp, dest)
        return True
    except OSError as exc:
        _cleanup_tmp(tmp, exc)
        return False


def _cleanup_tmp(tmp: Path, exc: OSError) -> None:
    """Delete a failed tmp file and log the error at the appropriate level."""
    try:
        tmp.unlink(missing_ok=True)
    except OSError:
        pass
    # ENOSPC gets a WARNING; everything else is DEBUG
    is_enospc = getattr(exc, "errno", None) == getattr(__import__("errno"), "ENOSPC", None)
    try:
        if is_enospc:
            log.warning("Disk full writing %s — write skipped.", tmp.parent / tmp.name.split(".")[0])
        else:
            log.debug("atomic_write %s: %s", tmp, exc)
    except NameError:
        print(f"[AM] write error {tmp}: {exc}", file=sys.stderr)


def _cleanup_stale_tmps() -> None:
    """
    Remove orphaned .tmp files left by a previous crash.
    Called once at startup; failures are silently ignored.
    """
    for d in (_DIR_CACHE, _DIR_SNAPSHOTS, _DIR_EXPORTS):
        try:
            for stale in d.glob("*.tmp"):
                try:
                    stale.unlink()
                except OSError:
                    pass
        except OSError:
            pass


_cleanup_stale_tmps()


# ─────────────────────────────────────────────────────────────────────────────
#  StorageHealth  —  disk-space and write-failure tracking
# ─────────────────────────────────────────────────────────────────────────────

class StorageHealth:
    """
    Lightweight storage health monitor.

    Tracks:
      - Available disk space (sampled every DISK_CHECK_INTERVAL writes)
      - Consecutive write failures (back off when disk is broken)

    Usage:
      if storage_health.is_healthy():
          _atomic_write_text(...)
    """

    DISK_CHECK_INTERVAL: int   = 50     # check disk space every N writes
    LOW_SPACE_WARN_MB:   float = 100.0  # warn when < 100 MB free
    CRIT_SPACE_MB:       float = 10.0   # refuse writes when < 10 MB free
    MAX_FAILURES:        int   = 5      # mark unhealthy after N consecutive fails

    def __init__(self, watch_path: Path) -> None:
        self._watch      = watch_path
        self._writes     = 0
        self._failures   = 0
        self._avail_mb   = float("inf")
        self._last_warn: float = 0.0

    def record_success(self) -> None:
        self._failures = 0
        self._writes  += 1
        if self._writes % self.DISK_CHECK_INTERVAL == 0:
            self._refresh_space()

    def record_failure(self) -> None:
        self._failures += 1
        if self._failures >= self.MAX_FAILURES:
            try:
                log.warning(
                    "StorageHealth: %d consecutive write failures on %s",
                    self._failures, self._watch,
                )
            except NameError:
                pass

    def is_healthy(self) -> bool:
        """Return True when writes should proceed."""
        if self._failures >= self.MAX_FAILURES:
            return False
        if self._avail_mb < self.CRIT_SPACE_MB:
            return False
        return True

    def available_mb(self) -> float:
        return self._avail_mb

    def _refresh_space(self) -> None:
        try:
            stat = os.statvfs(self._watch) if hasattr(os, "statvfs") else None
            if stat:
                self._avail_mb = stat.f_bavail * stat.f_frsize / 1_048_576
            else:
                # Windows fallback via shutil
                import shutil
                self._avail_mb = shutil.disk_usage(self._watch).free / 1_048_576
            now = time.time()
            if self._avail_mb < self.LOW_SPACE_WARN_MB and now - self._last_warn > 60:
                self._last_warn = now
                try:
                    log.warning(
                        "Low disk space: %.1f MB available on %s",
                        self._avail_mb, self._watch,
                    )
                except NameError:
                    pass
        except Exception:
            pass   # space check is best-effort


storage_health = StorageHealth(_DIR_DATA)


# ─────────────────────────────────────────────────────────────────────────────
#  WriteBackCache  —  in-memory dedup + batch before disk flush
# ─────────────────────────────────────────────────────────────────────────────

class WriteBackCache:
    """
    Accumulate pending writes in memory.  Deduplicates by content hash so
    identical successive payloads never hit the disk.

    API:
      cache.put(key, payload_bytes)   — stage a write
      cache.is_dirty(key)             — True if pending != last written
      cache.flush(key, dest)          — write to disk if dirty
      cache.flush_all(key_dest_map)   — flush all pending in one call
    """

    def __init__(self) -> None:
        self._pending:   Dict[str, bytes] = {}   # key -> bytes not yet written
        self._committed: Dict[str, str]   = {}   # key -> hash of last write

    def put(self, key: str, payload: bytes) -> None:
        """Stage *payload* for *key*.  Replaces any previous pending value."""
        self._pending[key] = payload

    def is_dirty(self, key: str) -> bool:
        """Return True when *key* has a pending payload that differs from last write."""
        if key not in self._pending:
            return False
        new_hash = hashlib.md5(self._pending[key]).hexdigest()
        return new_hash != self._committed.get(key, "")

    def flush(self, key: str, dest: Path) -> bool:
        """
        Write *key*'s pending payload to *dest* if dirty.
        Returns True when a write was performed or False when skipped/failed.
        """
        if not self.is_dirty(key):
            return False
        payload = self._pending.get(key)
        if payload is None:
            return False
        ok = _atomic_write_bytes(dest, payload)
        if ok:
            self._committed[key] = hashlib.md5(payload).hexdigest()
            storage_health.record_success()
        else:
            storage_health.record_failure()
        return ok

    def flush_text(self, key: str, dest: Path, encoding: str = "utf-8") -> bool:
        """Variant for text payloads stored as bytes."""
        if not self.is_dirty(key):
            return False
        payload = self._pending.get(key)
        if payload is None:
            return False
        try:
            text = payload.decode(encoding)
        except (UnicodeDecodeError, AttributeError):
            text = str(payload)
        ok = _atomic_write_text(dest, text, encoding)
        if ok:
            self._committed[key] = hashlib.md5(payload).hexdigest()
            storage_health.record_success()
        else:
            storage_health.record_failure()
        return ok

    def discard(self, key: str) -> None:
        """Remove a pending write without flushing (e.g. after external write)."""
        self._pending.pop(key, None)

    def pending_keys(self) -> List[str]:
        return list(self._pending.keys())


write_cache = WriteBackCache()


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 4 -- LOGGING
#
#  Architecture:
#    - RotatingFileHandler in data/logs/monitor.log
#      DEBUG+ → file  (2 MB × 3 backups = 6 MB ceiling)
#    - StreamHandler(stderr) → INFO+ (optional, activated by log_to_console)
#    - delay=True so the log file is not created until the first message
#  Thread safety: Python's logging is thread-safe by default.
#  Disk-full guard: if the file handler raises we fall back to stderr.
# ══════════════════════════════════════════════════════════════════════════════

_LOG_MAX_BYTES:    int = 2 * 1024 * 1024   # 2 MB per file
_LOG_BACKUP_COUNT: int = 3                 # monitor.log + 3 backups = 4 files
_LOG_PATH: Path = _DIR_LOGS / "monitor.log"

# Log format includes level-padded to 8 chars for easy grep
_LOG_FMT   = "[%(asctime)s] %(levelname)-8s %(message)s"
_LOG_DFMT  = "%Y-%m-%d %H:%M:%S"


def _build_logger() -> logging.Logger:
    logger = logging.getLogger("AM")
    logger.setLevel(logging.DEBUG)
    fmt = logging.Formatter(_LOG_FMT, datefmt=_LOG_DFMT)

    # Rotating file handler — defer file creation with delay=True
    try:
        fh = RotatingFileHandler(
            _LOG_PATH,
            maxBytes=_LOG_MAX_BYTES,
            backupCount=_LOG_BACKUP_COUNT,
            encoding="utf-8",
            delay=True,   # don't create the file until first log call
        )
        fh.setLevel(logging.DEBUG)
        fh.setFormatter(fmt)
        logger.addHandler(fh)
    except OSError as exc:
        sh = logging.StreamHandler(sys.stderr)
        sh.setFormatter(fmt)
        logger.addHandler(sh)
        logger.warning("Log file not writable (%s) — stderr only.", exc)

    return logger


log: logging.Logger = _build_logger()


def _die(msg: str) -> None:
    """Log a critical error and exit immediately."""
    log.critical(msg)
    sys.exit(1)


def _add_console_handler(level: int = logging.INFO) -> None:
    """
    Attach a stderr mirror for interactive / debug use.
    Idempotent: calling it twice does not add a second handler.
    """
    if any(isinstance(h, logging.StreamHandler) and h.stream is sys.stderr
           for h in log.handlers):
        return
    fmt = logging.Formatter(_LOG_FMT, datefmt=_LOG_DFMT)
    sh  = logging.StreamHandler(sys.stderr)
    sh.setFormatter(fmt)
    sh.setLevel(level)
    log.addHandler(sh)


def get_log_size_mb() -> float:
    """Return the current log file size in MB (0.0 if absent)."""
    try:
        return _LOG_PATH.stat().st_size / 1_048_576
    except OSError:
        return 0.0


