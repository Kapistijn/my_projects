<script>
// ════════════════════════════════════════════════════════════════════════════
//  SPA ENGINE — no page reload, surgical DOM updates only
// ════════════════════════════════════════════════════════════════════════════

'use strict';

// ── Constants ────────────────────────────────────────────────────────────────
const POLL_MS       = __INTERVAL__ * 1000;
const DATA_URL      = 'data.json';
const CHART_MAX_PTS = 120;

// ── Safe accessors ───────────────────────────────────────────────────────────
const $ = id => document.getElementById(id);
const na = v => (v == null || v === '' ? 'N/A' : v);

// Set an element's textContent only when the value actually changed.
// This avoids browser layout thrashing for static/unchanged values.
const _prev = {};
function setText(id, val) {
  const s = String(na(val));
  if (_prev[id] === s) return;
  _prev[id] = s;
  const el = $(id);
  if (el) el.textContent = s;
}

function setWidth(id, pct) {
  const el = $(id);
  if (!el) return;
  const w = Math.min(+pct || 0, 100).toFixed(1) + '%';
  if (el.style.width !== w) el.style.width = w;
}

function setClass(id, cls, on) {
  const el = $(id);
  if (el) el.classList.toggle(cls, on);
}

function show(id){ const el=$(id); if(el) el.classList.remove('hidden') }
function hide(id){ const el=$(id); if(el) el.classList.add('hidden') }

// ── Tab switching ─────────────────────────────────────────────────────────────
let _activeTab = 'cpu';

document.querySelectorAll('.tab').forEach(btn => {
  btn.addEventListener('click', () => {
    const tab = btn.dataset.tab;
    if (tab === _activeTab) return;
    _activeTab = tab;
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    const panel = $(`panel-${tab}`);
    if (panel) panel.classList.add('active');
  });
});

// ── Chart engine ──────────────────────────────────────────────────────────────
// Creates Chart.js line charts with shared styling.
// Charts push new points in-place without destroying and re-creating.

const _charts = {};

function _chartOpts(yMin, yMax, tooltipSuffix) {
  return {
    responsive: true,
    maintainAspectRatio: false,
    animation: { duration: 150 },
    interaction: { intersect: false, mode: 'index' },
    plugins: {
      legend: { display: false },
      tooltip: {
        backgroundColor: '#111928',
        borderColor: '#1c2a42', borderWidth: 1,
        titleFont: { family: 'JetBrains Mono', size: 9 },
        bodyFont:  { family: 'JetBrains Mono', size: 10 },
        callbacks: {
          label: ctx => ` ${ctx.parsed.y != null ? ctx.parsed.y.toFixed(1) : 'N/A'}${tooltipSuffix}`
        }
      }
    },
    scales: {
      x: {
        grid: { color: '#1c2a42' },
        ticks: { color: '#4a6080', font: { family: 'JetBrains Mono', size: 8 }, maxTicksLimit: 7 }
      },
      y: {
        grid: { color: '#1c2a42' },
        ticks: { color: '#4a6080', font: { family: 'JetBrains Mono', size: 9 } },
        min: yMin, max: yMax
      }
    }
  };
}

function makeChart(canvasId, color, bgColor, yMin, yMax, suffix='%') {
  const el = $(canvasId);
  if (!el) return null;
  const ch = new Chart(el, {
    type: 'line',
    data: {
      labels: [],
      datasets: [{
        data: [],
        borderColor: color,
        backgroundColor: bgColor,
        borderWidth: 1.5,
        pointRadius: 0,
        tension: 0.38,
        fill: true
      }]
    },
    options: _chartOpts(yMin, yMax, suffix)
  });
  _charts[canvasId] = ch;
  return ch;
}

// Seed a chart with historical data; called once after first successful fetch.
function seedChart(canvasId, labels, values) {
  const ch = _charts[canvasId];
  if (!ch) return;
  ch.data.labels   = [...labels].slice(-CHART_MAX_PTS);
  ch.data.datasets[0].data = [...values].slice(-CHART_MAX_PTS);
  ch.update('none');
}

// Push one new data point; shift oldest off when at capacity.
function pushChart(canvasId, label, value) {
  const ch = _charts[canvasId];
  if (!ch) return;
  ch.data.labels.push(label);
  ch.data.datasets[0].data.push(value ?? null);
  if (ch.data.labels.length > CHART_MAX_PTS) {
    ch.data.labels.shift();
    ch.data.datasets[0].data.shift();
  }
  ch.update('none');
}

// Update Y-axis range without a full rebuild.
function setYRange(canvasId, yMin, yMax) {
  const ch = _charts[canvasId];
  if (!ch) return;
  const sc = ch.options.scales.y;
  if (sc.min !== yMin || sc.max !== yMax) {
    sc.min = yMin; sc.max = yMax;
  }
}

// ── Chart initialisation ──────────────────────────────────────────────────────
let _chartsReady = false;

function initCharts(d) {
  const r = d.ranges || {};
  makeChart('ch-cpu',  '#00e5ff', 'rgba(0,229,255,.07)',  ...(r.cpu  || [0,100]), '%');
  makeChart('ch-temp', '#ff6b35', 'rgba(255,107,53,.06)', 0, null, '°C');
  makeChart('ch-ram',  '#ff6b35', 'rgba(255,107,53,.07)', ...(r.ram  || [0,100]), '%');
  makeChart('ch-gpu',  '#bd93f9', 'rgba(189,147,249,.07)',...(r.gpu  || [0,100]), '%');
  makeChart('ch-tx',   '#00e5ff', 'rgba(0,229,255,.06)',  0, (r.net || [0,1])[1], ' KB/s');
  makeChart('ch-rx',   '#8be9fd', 'rgba(139,233,253,.06)',0, (r.net || [0,1])[1], ' KB/s');
  makeChart('ch-drd',  '#7fff7f', 'rgba(127,255,127,.06)',0, null, ' MB/s');
  makeChart('ch-dwr',  '#ff79c6', 'rgba(255,121,198,.06)',0, null, ' MB/s');

  // Seed from history
  const h   = d.history || [];
  const lbl = h.map(x => x.ts);
  seedChart('ch-cpu',  lbl, h.map(x => x.cpu));
  seedChart('ch-temp', lbl, h.map(x => x.temp));
  seedChart('ch-ram',  lbl, h.map(x => x.ram));
  seedChart('ch-gpu',  lbl, h.map(x => x.gpu));
  seedChart('ch-tx',   lbl, h.map(x => x.tx));
  seedChart('ch-rx',   lbl, h.map(x => x.rx));
  seedChart('ch-drd',  lbl, h.map(x => x.drd));
  seedChart('ch-dwr',  lbl, h.map(x => x.dwr));

  _chartsReady = true;
}

// ── Uptime formatter ─────────────────────────────────────────────────────────
function fmtUptime(s) {
  if (s == null) return 'N/A';
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const sc = s % 60;
  if (h) return `${h}h ${String(m).padStart(2,'0')}m`;
  if (m) return `${m}m ${String(sc).padStart(2,'0')}s`;
  return `${sc}s`;
}

// ── Minibar helper ────────────────────────────────────────────────────────────
function minibar(val, max, color) {
  const pct = max > 0 ? Math.min(val / max * 100, 100).toFixed(0) : 0;
  return `<span class="minibar"><span class="minibar-fill" style="width:${pct}%;background:${color}"></span></span>`;
}

// ── Table renderer — full rebuild only when row count or names change ─────────
// Uses a keyed approach: rows are re-used when the process name is the same.
// This avoids the cost of destroying and re-creating DOM on every cycle.

const _tbodyState = {};   // key: tbody id -> { rows: Map<name, tr> }

function updateTable(tbodyId, items, colFns) {
  const tbody = $(tbodyId);
  if (!tbody) return;

  const state = _tbodyState[tbodyId] || (_tbodyState[tbodyId] = { rows: new Map() });
  const newNames = new Set(items.map(r => r.name));

  // Remove rows for items no longer in the list
  for (const [name, tr] of state.rows) {
    if (!newNames.has(name)) {
      tbody.removeChild(tr);
      state.rows.delete(name);
    }
  }

  // Update or insert rows in order
  let refNode = tbody.firstChild;
  for (const item of items) {
    let tr = state.rows.get(item.name);
    if (!tr) {
      tr = document.createElement('tr');
      state.rows.set(item.name, tr);
    }
    // Re-render cell HTML only if content changed
    const newHtml = colFns.map(fn => `<td>${fn(item)}</td>`).join('');
    if (tr.innerHTML !== newHtml) tr.innerHTML = newHtml;

    // Maintain visual order
    if (tr !== refNode) tbody.insertBefore(tr, refNode);
    refNode = tr.nextSibling;
  }
}

// Table column sort
const _sortState = {};
document.querySelectorAll('thead th[data-col]').forEach(th => {
  th.addEventListener('click', () => {
    const tbl    = th.closest('table');
    const colIdx = +th.dataset.col;
    const id     = tbl.id;
    const prev   = _sortState[id] || { col: -1, asc: true };
    const asc    = prev.col === colIdx ? !prev.asc : true;
    _sortState[id] = { col: colIdx, asc };

    // Reset all header classes in this table
    tbl.querySelectorAll('thead th').forEach(h => h.classList.remove('sort-asc','sort-desc'));
    th.classList.add(asc ? 'sort-asc' : 'sort-desc');

    // Sort rows by cell text/data-v attribute
    const tbody = tbl.querySelector('tbody');
    [...tbody.querySelectorAll('tr')].sort((a, b) => {
      const av = a.cells[colIdx]?.dataset?.v ?? a.cells[colIdx]?.textContent ?? '';
      const bv = b.cells[colIdx]?.dataset?.v ?? b.cells[colIdx]?.textContent ?? '';
      const n  = v => isNaN(+v) ? v : +v;
      return (asc ? 1 : -1) * (n(av) > n(bv) ? 1 : n(av) < n(bv) ? -1 : 0);
    }).forEach(r => tbody.appendChild(r));
  });
});

// ── Core grid renderer ────────────────────────────────────────────────────────
let _coreCount = 0;

function renderCoreGrid(cores) {
  const grid = $('core-grid');
  if (!grid) return;
  if (!cores || cores.length === 0) {
    grid.innerHTML = '<span class="na">Per-core data unavailable</span>';
    return;
  }

  // Rebuild only when core count changes (first render or CPU topology change)
  if (cores.length !== _coreCount) {
    _coreCount = cores.length;
    grid.innerHTML = cores.map((_, i) => `
      <div class="core-card">
        <div class="core-lbl">Core ${i}</div>
        <div class="core-val"><span id="core-${i}">—</span><span class="cu">%</span></div>
        <div class="gbar-wrap"><div class="gbar" id="core-g-${i}"
          style="background:linear-gradient(90deg,var(--c1),#0080ff)"></div></div>
      </div>`).join('');
  }

  // Update values in-place
  cores.forEach((v, i) => {
    setText(`core-${i}`, v ?? 'N/A');
    setWidth(`core-g-${i}`, v ?? 0);
  });
}

// ── Interface grid renderer ───────────────────────────────────────────────────
let _lastIfaceJson = '';

function renderIfaceGrid(ifaces) {
  const grid = $('iface-grid');
  if (!grid) return;

  const json = JSON.stringify(ifaces);
  if (json === _lastIfaceJson) return;   // nothing changed
  _lastIfaceJson = json;

  if (!ifaces || !ifaces.length) {
    grid.innerHTML = '<span class="na">No interface data available</span>';
    return;
  }

  grid.innerHTML = ifaces.map(i => `
    <div class="iface-card">
      <div class="iface-name">
        <span class="${i.up ? 'dot-up' : 'dot-down'}">●</span>
        ${i.name || 'Unknown'}
      </div>
      <div class="iface-row">IPv4    <span>${i.ipv4 || 'N/A'}</span></div>
      <div class="iface-row">Speed   <span>${i.speed ? i.speed + ' Mbps' : 'N/A'}</span></div>
      <div class="iface-row">Sent    <span>${i.sent_mb != null ? i.sent_mb + ' MB' : 'N/A'}</span></div>
      <div class="iface-row">Received<span>${i.recv_mb != null ? i.recv_mb + ' MB' : 'N/A'}</span></div>
    </div>`).join('');
}

// ── Partition list renderer ───────────────────────────────────────────────────
let _lastPartsJson = '';

function renderPartitions(parts) {
  const list = $('part-list');
  if (!list) return;

  const json = JSON.stringify(parts);
  if (json === _lastPartsJson) return;
  _lastPartsJson = json;

  if (!parts || !parts.length) {
    list.innerHTML = '<div class="na" style="padding:12px">No partition data available</div>';
    return;
  }

  const palette = ['var(--c4)','var(--c1)','var(--c3)','var(--c6)','var(--c5)'];
  list.innerHTML = parts.map((p, i) => {
    const pct   = p.used_pct ?? 0;
    const color = pct > 90 ? '#ff5555' : pct > 75 ? 'var(--c2)' : palette[i % palette.length];
    return `
    <div class="part-card">
      <div class="part-top">
        <span class="part-name">
          ${p.mountpoint || 'N/A'}
          <span class="part-fstype">${p.fstype || '?'}</span>
        </span>
        <span class="part-pct">${pct}%</span>
      </div>
      <div class="part-bar">
        <div class="part-bar-fill" style="width:${pct}%;background:${color}"></div>
      </div>
      <div class="part-meta">
        <span>Total <b>${p.total_gb ?? 'N/A'} GB</b></span>
        <span>Used  <b>${p.used_gb  ?? 'N/A'} GB</b></span>
        <span>Free  <b>${p.free_gb  ?? 'N/A'} GB</b></span>
        <span style="color:var(--muted)">${p.device || ''}</span>
      </div>
    </div>`;
  }).join('');
}

// ════════════════════════════════════════════════════════════════════════════
//  MAIN UPDATE FUNCTION — called on every successful poll
//  Each section only touches the DOM nodes it owns.
// ════════════════════════════════════════════════════════════════════════════

function update(d) {
  if (!_chartsReady) initCharts(d);

  const hist = d.history || [];
  const ts   = hist.length ? hist[hist.length - 1].ts : '';
  const lv   = hist.length ? hist[hist.length - 1]    : {};

  // ── Header ────────────────────────────────────────────────────────────────
  const sess = d.session || {};
  setText('h-host',  `${sess.user || '?'}@${sess.host || '?'} · ${(sess.os || '').split('-')[0]}`);
  setText('h-uptime', fmtUptime(d.uptime));
  setText('h-ts',     (d.ts || '').slice(11, 19));
  setText('h-snaps',  d.snaps ?? 'N/A');
  setText('h-procs',  d.procs ?? 'N/A');

  const storOk = sess.storage_ok !== false;
  setText('h-storage', storOk
    ? `${sess.disk_free_mb ?? '?'} MB free`
    : 'Low space!');
  setClass('h-storage-badge', 'warn', !storOk);
  setClass('hpulse', 'error', !storOk);

  // ── Footer ────────────────────────────────────────────────────────────────
  setText('footer',
    `Activity Monitor · ${(sess.os || '').split('-')[0]} · interval __INTERVAL__s · ${d.ts || ''}`
  );

  // ── CPU tab ──────────────────────────────────────────────────────────────
  const cpu = d.cpu || {};
  setText('cpu-tot',      cpu.now   ?? 'N/A');
  setWidth('cpu-tot-g',   cpu.now   ?? 0);
  setText('cpu-pk',       cpu.peak  ?? 'N/A');
  setText('cpu-av',       cpu.avg   ?? 'N/A');
  setText('c-cpu-pk',    (cpu.peak  ?? 'N/A') + '%');
  setText('cpu-temp',     cpu.temp_c != null ? cpu.temp_c : 'N/A');
  setText('cpu-freq',     cpu.freq_mhz ? Math.round(cpu.freq_mhz) : 'N/A');
  setText('cpu-freq-max', cpu.freq_max_mhz ? Math.round(cpu.freq_max_mhz) : '—');
  setText('cpu-logi',     cpu.logi  ?? 'N/A');
  setText('cpu-phys',     cpu.phys  ?? 'N/A');
  renderCoreGrid(cpu.per_core);

  const cpuTop = cpu.top || [];
  setText('cpu-proc-count', cpuTop.length + ' processes');
  updateTable('tbody-cpu', cpuTop, [
    r => `<span class="td-name" title="${r.name}">${r.name}</span>`,
    r => `<span class="td-cpu" data-v="${r.cpu}">${r.cpu}%${minibar(r.cpu, 100, 'var(--c1)')}</span>`,
    r => `<span class="td-ram" data-v="${r.mem_mb}">${r.mem_mb}</span>`,
    r => `<span class="td-muted" data-v="${r.inst}">${r.inst}</span>`,
  ]);

  // ── RAM tab ───────────────────────────────────────────────────────────────
  const ram = d.ram || {};
  setText('ram-pct',      ram.pct     ?? 'N/A');
  setWidth('ram-g',       ram.pct     ?? 0);
  setText('ram-used',     ram.used_mb ?? 'N/A');
  setText('ram-tot',      ram.total_mb ?? 'N/A');
  setText('ram-avail',    ram.avail_mb ?? 'N/A');
  setText('ram-pk',       ram.peak    ?? 'N/A');
  setText('ram-av',       ram.avg     ?? 'N/A');
  setText('c-ram-pk',    (ram.peak    ?? 'N/A') + '%');
  setText('ram-swap-pct', ram.swap_pct ?? 'N/A');
  setWidth('swap-g',      ram.swap_pct ?? 0);
  setText('ram-swap-used', ram.swap_used_mb  ?? 'N/A');
  setText('ram-swap-tot',  ram.swap_total_mb ?? 'N/A');

  const ramTop = ram.top || [];
  setText('ram-proc-count', ramTop.length + ' processes');
  const ramTotalMb = ram.total_mb || 1;
  updateTable('tbody-ram', ramTop, [
    r => `<span class="td-name" title="${r.name}">${r.name}</span>`,
    r => `<span class="td-ram" data-v="${r.mem_mb}">${r.mem_mb} MB${minibar(r.mem_mb, ramTotalMb, 'var(--c2)')}</span>`,
    r => `<span class="td-cpu" data-v="${r.cpu}">${r.cpu}%</span>`,
    r => `<span class="td-muted" data-v="${r.inst}">${r.inst}</span>`,
  ]);

  // ── GPU tab ───────────────────────────────────────────────────────────────
  const gpu = d.gpu || {};
  if (gpu.available) {
    show('gpu-ok-section'); hide('gpu-unavail');
    setText('gpu-load',    gpu.load    ?? 'N/A');
    setWidth('gpu-load-g', gpu.load    ?? 0);
    setText('gpu-pk',      gpu.peak    ?? 'N/A');
    setText('c-gpu-pk',   (gpu.peak    ?? 'N/A') + '%');
    setText('gpu-mem',     gpu.mem_pct ?? 'N/A');
    setWidth('gpu-mem-g',  gpu.mem_pct ?? 0);
    setText('gpu-temp',    gpu.temp_c  ?? 'N/A');
    setText('gpu-backend', gpu.backend || 'N/A');

    const gpuTop = gpu.top || [];
    setText('gpu-proc-count', gpuTop.length + ' processes');
    updateTable('tbody-gpu', gpuTop, [
      r => `<span class="td-name" title="${r.name}">${r.name}</span>`,
      r => `<span class="td-gpu" data-v="${r.gpu_mb}">${r.gpu_mb} MB${minibar(r.gpu_mb, 8192, 'var(--c4)')}</span>`,
      r => `<span class="td-cpu" data-v="${r.cpu}">${r.cpu}%</span>`,
      r => `<span class="td-ram" data-v="${r.mem_mb}">${r.mem_mb}</span>`,
      r => `<span class="td-muted" data-v="${r.inst}">${r.inst}</span>`,
    ]);
  } else {
    hide('gpu-ok-section'); show('gpu-unavail');
  }

  // ── Network tab ───────────────────────────────────────────────────────────
  const net = d.net || {};
  setText('net-tx',   net.tx_kb   ?? 'N/A');
  setText('net-rx',   net.rx_kb   ?? 'N/A');
  setText('net-ptx',  net.peak_tx ?? 'N/A');
  setText('net-prx',  net.peak_rx ?? 'N/A');
  setText('net-ssid', net.ssid   || 'N/A');
  setText('net-sig',  net.signal_dbm != null ? net.signal_dbm : 'N/A');
  setText('net-iface', net.iface || 'N/A');
  renderIfaceGrid(net.all_ifaces || []);

  // ── Storage tab ───────────────────────────────────────────────────────────
  const disk = d.disk || {};
  setText('disk-rd',    disk.read_mbs  ?? 'N/A');
  setText('disk-wr',    disk.write_mbs ?? 'N/A');
  setText('disk-pct',   disk.used_pct  ?? 'N/A');
  setWidth('disk-g',    disk.used_pct  ?? 0);
  setText('disk-path-lbl', disk.path   || 'N/A');
  setText('disk-free',  disk.free_gb   ?? 'N/A');
  setText('disk-total', disk.total_gb  ?? 'N/A');
  renderPartitions(disk.partitions || []);

  // ── Dynamic Y-range updates (no chart rebuild) ────────────────────────────
  const ranges = d.ranges || {};
  if (ranges.cpu)  setYRange('ch-cpu',  ranges.cpu[0],  ranges.cpu[1]);
  if (ranges.ram)  setYRange('ch-ram',  ranges.ram[0],  ranges.ram[1]);
  if (ranges.gpu)  setYRange('ch-gpu',  ranges.gpu[0],  ranges.gpu[1]);
  if (ranges.net) {
    setYRange('ch-tx', 0, ranges.net[1]);
    setYRange('ch-rx', 0, ranges.net[1]);
  }

  // ── Chart push (live point only) ──────────────────────────────────────────
  if (ts) {
    pushChart('ch-cpu',  ts, lv.cpu  ?? null);
    pushChart('ch-temp', ts, lv.temp ?? null);
    pushChart('ch-ram',  ts, lv.ram  ?? null);
    pushChart('ch-gpu',  ts, lv.gpu  ?? null);
    pushChart('ch-tx',   ts, lv.tx   ?? null);
    pushChart('ch-rx',   ts, lv.rx   ?? null);
    pushChart('ch-drd',  ts, lv.drd  ?? null);
    pushChart('ch-dwr',  ts, lv.dwr  ?? null);
  }
}

// ════════════════════════════════════════════════════════════════════════════
//  POLL LOOP — exponential back-off on failure, no freeze on large payloads
// ════════════════════════════════════════════════════════════════════════════

let _pollTimer   = null;
let _failStreak  = 0;
const _MAX_FAIL_DELAY = 30_000;

async function poll() {
  try {
    const resp = await fetch(DATA_URL + '?t=' + Date.now());
    if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
    const d = await resp.json();
    _failStreak = 0;
    update(d);
  } catch (err) {
    _failStreak++;
    // Indicate connection issue in header
    setClass('hpulse', 'error', true);
    const msg = `Offline · retrying (${_failStreak}) · ${err.message}`;
    setText('h-ts', msg.slice(0, 50));
    console.warn('[AM] poll error:', err.message);
  } finally {
    // Back-off: double delay per failure up to MAX_FAIL_DELAY
    const delay = _failStreak > 0
      ? Math.min(POLL_MS * (2 ** (_failStreak - 1)), _MAX_FAIL_DELAY)
      : POLL_MS;
    _pollTimer = setTimeout(poll, delay);
  }
}

// Kick off on load
poll();
</script>
</body></html>
