# Tracks which directories are confirmed usable after _init_dirs()
_DIR_STATUS: Dict[str, bool] = {}


def _init_dirs() -> None:
    """
    Create the full directory tree.
    Each directory is attempted independently so one failure doesn't block
    the rest.  Results are stored in _DIR_STATUS for health checks.
    """
    for d in (_DIR_DATA, _DIR_LOGS, _DIR_SNAPSHOTS, _DIR_CACHE, _DIR_EXPORTS):
        try:
            d.mkdir(parents=True, exist_ok=True)
            _DIR_STATUS[str(d)] = True
        except OSError as exc:
            _DIR_STATUS[str(d)] = False
            print(f"[AM] WARNING: cannot create {d}: {exc}", file=sys.stderr)


