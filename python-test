# Monotonic counter for unique tmp-file names (avoids PID collisions on fork)
_TMP_COUNTER: int = 0


# ─────────────────────────────────────────────────────────────────────────────
#  Directory resolution with graceful fallback chain
# ─────────────────────────────────────────────────────────────────────────────

def _probe_writable(path: Path) -> bool:
    """
    Return True only when *path* exists (or can be created) AND is writable.
    Creates the directory if absent; performs a create+delete probe file.
    """
    try:
        path.mkdir(parents=True, exist_ok=True)
        probe = path / f".write_probe_{os.getpid()}"
        probe.write_text("ok", encoding="utf-8")
        probe.unlink()
        return True
    except OSError:
        return False


def _resolve_base_dir() -> Path:
    """
    Return the first writable candidate from the fallback chain:
      ~/activity_monitor  ->  {tempdir}/activity_monitor  ->  ./activity_monitor
    If all fail, return cwd() (writes will fail gracefully later).
    """
    candidates: List[Path] = [
        Path.home() / "activity_monitor",
        Path(tempfile.gettempdir()) / "activity_monitor",
        Path.cwd() / "activity_monitor",
    ]
    for c in candidates:
        if _probe_writable(c):
            return c
    return Path.cwd()   # last resort; individual writes will catch errors


BASE_DIR: Path = _resolve_base_dir()

