#  SECTION 9 — THREAD-SAFE TTL CACHE
# ══════════════════════════════════════════════════════════════════════════════

class _Cache:
    """
    Simple in-memory key/value store with per-entry TTL expiry.
    All operations are thread-safe via a single reentrant lock.
    """

    def __init__(self, ttl: int) -> None:
        self._d:   Dict[str, Tuple[Any, float]] = {}
        self._ttl: int = ttl
        self._lock = threading.Lock()

    def get(self, key: str) -> Optional[Any]:
        with self._lock:
            entry = self._d.get(key)
            if entry is None:
                return None
            value, stored_at = entry
            if time.time() - stored_at > self._ttl:
                del self._d[key]
                return None
            return value

    def set(self, key: str, val: Any) -> None:
        with self._lock:
            self._d[key] = (val, time.time())

    def drop(self, key: str) -> None:
        with self._lock:
            self._d.pop(key, None)

    def clear(self) -> None:
        with self._lock:
            self._d.clear()

    def __len__(self) -> int:
        with self._lock:
            return len(self._d)


_cache = _Cache(CACHE_TTL)


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 10 — GPU  (NVIDIA · AMD · Intel · macOS · Windows · Linux /sys)
#
#  Detection tries each backend in order of richness.  A backend is accepted
#  only if it can actually enumerate at least one device.  Every backend is
#  wrapped in its own try/except so a broken library never blocks the others.
#
#  Supported backends
#  ─────────────────
#  pynvml      – NVIDIA, full detail + per-process VRAM (best on Linux/Win)
#  nvidiasmi   – NVIDIA fallback via CLI (slower, no library needed)
#  gputil      – NVIDIA wrapper (thin, Windows-friendly)
#  amd         – AMD via pyamdgpuinfo (Linux)
#  macos_sp    – any GPU via system_profiler (macOS, load not available)
#  win_wmic    – any GPU via WMIC (Windows, load via PDH or unavailable)
#  intel_sys   – Intel iGPU via /sys frequency proxy (Linux)
#  linux_drm   – generic DRM card via /sys (Linux, load not available)
# ══════════════════════════════════════════════════════════════════════════════

_gpu_backend:   str  = ""                                        # active backend name
_gpu_cache_lk:  threading.Lock = threading.Lock()
_gpu_raw_cache: Optional[Tuple[List["GpuInfo"], Dict[str, int], float]] = None


# ── Backend probes (return True only when at least one device is usable) ─────

def _probe_pynvml() -> bool:
    import pynvml
    pynvml.nvmlInit()
    return pynvml.nvmlDeviceGetCount() > 0

def _probe_nvidiasmi() -> bool:
    r = subprocess.run(
        ["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"],
        capture_output=True, timeout=2)
    return r.returncode == 0 and bool(r.stdout.strip())

def _probe_gputil() -> bool:
    import GPUtil
    return len(GPUtil.getGPUs()) > 0

def _probe_amd() -> bool:
    import pyamdgpuinfo
    return pyamdgpuinfo.detect_gpus() > 0

def _probe_macos_sp() -> bool:
    if not IS_MACOS:
        return False
    r = subprocess.run(
        ["system_profiler", "SPDisplaysDataType", "-json"],
        capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        return False
    try:
        data = json.loads(r.stdout)
        return bool(data.get("SPDisplaysDataType"))
    except Exception:
        return False

def _probe_win_wmic() -> bool:
    if not IS_WINDOWS:
        return False
    r = subprocess.run(
        ["wmic", "path", "win32_videocontroller", "get", "name", "/format:list"],
        capture_output=True, text=True, timeout=3)
    return r.returncode == 0 and "Name=" in r.stdout

def _probe_intel_sys() -> bool:
    if not IS_LINUX:
        return False
    return os.path.exists("/sys/class/drm/card0/gt_cur_freq_mhz")

def _probe_linux_drm() -> bool:
    if not IS_LINUX:
        return False
    try:
        cards = [p for p in os.listdir("/sys/class/drm")
                 if p.startswith("card") and not p[4:].startswith("-")]
        return bool(cards)
    except Exception:
        return False

_GPU_PROBES: List[Tuple[str, Any]] = [
    ("pynvml",    _probe_pynvml),
    ("nvidiasmi", _probe_nvidiasmi),
    ("gputil",    _probe_gputil),
    ("amd",       _probe_amd),
    ("macos_sp",  _probe_macos_sp),
    ("win_wmic",  _probe_win_wmic),
    ("intel_sys", _probe_intel_sys),
    ("linux_drm", _probe_linux_drm),
]

def _detect_gpu() -> None:
    global _gpu_backend
    for name, probe in _GPU_PROBES:
        try:
            if probe():
                _gpu_backend = name
                log.info("GPU backend: %s", name)
                return
        except ImportError:
            log.debug("GPU probe %s: library not installed.", name)
        except FileNotFoundError:
            log.debug("GPU probe %s: tool not found.", name)
        except Exception as exc:
            log.debug("GPU probe %s failed: %s", name, exc)
    log.info("No GPU backend found — GPU tab will show 'unavailable'.")

_detect_gpu()


# ── Per-backend query ─────────────────────────────────────────────────────────

def _safe_float(v: Any, default: float = 0.0) -> float:
    try:
        return float(v) if v is not None else default
    except (TypeError, ValueError):
        return default

def _safe_int(v: Any, default: int = 0) -> int:
    try:
        return int(v) if v is not None else default
    except (TypeError, ValueError):
        return default


def _query_pynvml() -> Tuple[List[GpuInfo], Dict[str, int]]:
    import pynvml
    gpus: List[GpuInfo] = []
    gpu_procs: Dict[str, int] = {}
    for i in range(pynvml.nvmlDeviceGetCount()):
        h = pynvml.nvmlDeviceGetHandleByIndex(i)
        try:
            u  = pynvml.nvmlDeviceGetUtilizationRates(h)
            m  = pynvml.nvmlDeviceGetMemoryInfo(h)
            nm = pynvml.nvmlDeviceGetName(h)
            if isinstance(nm, bytes):
                nm = nm.decode(errors="replace")
            mu = m.used  // 1024 ** 2
            mt = m.total // 1024 ** 2
            try:
                t = float(pynvml.nvmlDeviceGetTemperature(h, pynvml.NVML_TEMPERATURE_GPU))
            except Exception:
                t = 0.0
            gpus.append(GpuInfo(
                name=nm, load_pct=_safe_float(u.gpu),
                mem_used=mu, mem_total=mt,
                mem_pct=round(mu / mt * 100, 1) if mt else 0.0,
                temp_c=t,
            ))
            # Per-process VRAM mapping
            for fn in (pynvml.nvmlDeviceGetComputeRunningProcesses,
                       pynvml.nvmlDeviceGetGraphicsRunningProcesses):
                try:
                    for p in fn(h):
                        try:
                            pnm = pynvml.nvmlSystemGetProcessName(p.pid)
                            if isinstance(pnm, bytes):
                                pnm = pnm.decode(errors="replace")
                            pnm = os.path.basename(pnm)
                            vm  = _safe_int(p.usedGpuMemory) // 1024 ** 2
                            gpu_procs[pnm] = gpu_procs.get(pnm, 0) + vm
                        except Exception:
                            pass
                except Exception:
                    pass
        except Exception as exc:
            log.debug("pynvml device %d: %s", i, exc)
    return gpus, gpu_procs


def _query_nvidiasmi() -> Tuple[List[GpuInfo], Dict[str, int]]:
    gpus: List[GpuInfo] = []
    gpu_procs: Dict[str, int] = {}
    try:
        r = subprocess.run(
            ["nvidia-smi",
             "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=4)
        for line in r.stdout.strip().splitlines():
            p = [x.strip() for x in line.split(",")]
            if len(p) >= 5:
                mu, mt = _safe_int(p[2]), _safe_int(p[3])
                gpus.append(GpuInfo(
                    name=p[0], load_pct=_safe_float(p[1]),
                    mem_used=mu, mem_total=mt,
                    mem_pct=round(mu / mt * 100, 1) if mt else 0.0,
                    temp_c=_safe_float(p[4]),
                ))
    except Exception as exc:
        log.debug("nvidia-smi query: %s", exc)
    # Per-process VRAM
    try:
        r2 = subprocess.run(
            ["nvidia-smi", "--query-compute-apps=pid,name,used_memory",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=4)
        for line in r2.stdout.strip().splitlines():
            p = [x.strip() for x in line.split(",")]
            if len(p) >= 3:
                pnm = os.path.basename(p[1])
                gpu_procs[pnm] = gpu_procs.get(pnm, 0) + _safe_int(p[2])
    except Exception:
        pass
    return gpus, gpu_procs


def _query_gputil() -> Tuple[List[GpuInfo], Dict[str, int]]:
    import GPUtil
    gpus: List[GpuInfo] = []
    for g in GPUtil.getGPUs():
        mu, mt = _safe_int(g.memoryUsed), _safe_int(g.memoryTotal)
        gpus.append(GpuInfo(
            name=g.name or "GPU",
            load_pct=round(_safe_float(g.load) * 100, 1),
            mem_used=mu, mem_total=mt,
            mem_pct=round(_safe_float(g.memoryUtil) * 100, 1),
            temp_c=_safe_float(g.temperature),
        ))
    return gpus, {}


def _query_amd() -> Tuple[List[GpuInfo], Dict[str, int]]:
    import pyamdgpuinfo
    gpus: List[GpuInfo] = []
    for i in range(pyamdgpuinfo.detect_gpus()):
        try:
            g    = pyamdgpuinfo.get_gpu(i)
            load = round(_safe_float(g.query_load()) * 100, 1)
            mu   = _safe_int((g.query_vram_usage() or 0) // 1024 ** 2)
            mt   = _safe_int((g.memory_info.get("vram_size", 0)) // 1024 ** 2)
            temp = _safe_float(g.query_temperature())
            gpus.append(GpuInfo(
                name=g.name or "AMD GPU",
                load_pct=load,
                mem_used=mu, mem_total=mt,
                mem_pct=round(mu / mt * 100, 1) if mt else 0.0,
                temp_c=temp,
            ))
        except Exception as exc:
            log.debug("AMD GPU %d: %s", i, exc)
    return gpus, {}


def _query_macos_sp() -> Tuple[List[GpuInfo], Dict[str, int]]:
    """macOS system_profiler: name only (load/temp not exposed without root)."""
    gpus: List[GpuInfo] = []
    try:
        r = subprocess.run(
            ["system_profiler", "SPDisplaysDataType", "-json"],
            capture_output=True, text=True, timeout=6)
        data = json.loads(r.stdout)
        for item in data.get("SPDisplaysDataType", []):
            name = item.get("sppci_model") or item.get("_name") or "GPU"
            vram_str = item.get("spdisplays_vram") or item.get("spdisplays_vram_shared") or ""
            # Parse VRAM string like "8 GB" or "1536 MB"
            mt = 0
            parts = vram_str.upper().split()
            if len(parts) == 2:
                try:
                    num = int(parts[0])
                    mt  = num * 1024 if parts[1] == "GB" else num
                except ValueError:
                    pass
            gpus.append(GpuInfo(name=name, mem_total=mt))
    except Exception as exc:
        log.debug("macOS system_profiler GPU: %s", exc)
    return gpus, {}


def _query_win_wmic() -> Tuple[List[GpuInfo], Dict[str, int]]:
    """Windows WMIC: name + VRAM (load via PDH is too heavy; omitted)."""
    gpus: List[GpuInfo] = []
    try:
        r = subprocess.run(
            ["wmic", "path", "win32_videocontroller",
             "get", "Name,AdapterRAM", "/format:csv"],
            capture_output=True, text=True, timeout=5)
        for line in r.stdout.strip().splitlines()[1:]:  # skip header
            p = [x.strip() for x in line.split(",")]
            # CSV format: Node,AdapterRAM,Name
            if len(p) >= 3 and p[-1]:
                mt = _safe_int(p[-2]) // 1024 ** 2
                gpus.append(GpuInfo(name=p[-1], mem_total=mt))
    except Exception as exc:
        log.debug("Windows WMIC GPU: %s", exc)
    return gpus, {}


def _query_intel_sys() -> Tuple[List[GpuInfo], Dict[str, int]]:
    """Intel iGPU on Linux: approximate load from GT frequency ratio."""
    try:
        cur_p = "/sys/class/drm/card0/gt_cur_freq_mhz"
        max_p = "/sys/class/drm/card0/gt_max_freq_mhz"
        freq  = int(Path(cur_p).read_text().strip())
        mf    = max(1, int(Path(max_p).read_text().strip())) if Path(max_p).exists() else 100
        load  = round(freq / mf * 100, 1)
        return [GpuInfo(name="Intel iGPU", load_pct=load)], {}
    except Exception as exc:
        log.debug("Intel /sys GPU: %s", exc)
    return [], {}


def _query_linux_drm() -> Tuple[List[GpuInfo], Dict[str, int]]:
    """Generic DRM card detection (name from /sys, no load available)."""
    gpus: List[GpuInfo] = []
    try:
        drm = Path("/sys/class/drm")
        for card in sorted(drm.iterdir()):
            if not card.name.startswith("card") or card.name[4:].startswith("-"):
                continue
            vendor_p = card / "device" / "vendor"
            name_p   = card / "device" / "uevent"
            name = card.name
            if name_p.exists():
                for ln in name_p.read_text(errors="replace").splitlines():
                    if ln.startswith("DRIVER="):
                        name = f"{card.name} ({ln.split('=',1)[1]})"
                        break
            gpus.append(GpuInfo(name=name))
    except Exception as exc:
        log.debug("Linux DRM GPU: %s", exc)
    return gpus, {}


_GPU_QUERIES: Dict[str, Any] = {
    "pynvml":    _query_pynvml,
    "nvidiasmi": _query_nvidiasmi,
    "gputil":    _query_gputil,
    "amd":       _query_amd,
    "macos_sp":  _query_macos_sp,
    "win_wmic":  _query_win_wmic,
    "intel_sys": _query_intel_sys,
    "linux_drm": _query_linux_drm,
}


def _query_gpu_raw() -> Tuple[List[GpuInfo], Dict[str, int]]:
    if not _gpu_backend:
        return [], {}
    fn = _GPU_QUERIES.get(_gpu_backend)
    if fn is None:
        return [], {}
    try:
        return fn()
    except Exception as exc:
        log.debug("GPU query (%s) failed: %s\n%s", _gpu_backend, exc, traceback.format_exc())
        return [], {}


def get_gpu() -> Tuple[List[GpuInfo], Dict[str, int]]:
    """Return (gpu_list, gpu_proc_map) from cache or a fresh query."""
    global _gpu_raw_cache
    now = time.time()
    with _gpu_cache_lk:
        if _gpu_raw_cache and now - _gpu_raw_cache[2] < GPU_CACHE_TTL:
            return _gpu_raw_cache[0], _gpu_raw_cache[1]
        gpus, procs = _query_gpu_raw()
        _gpu_raw_cache = (gpus, procs, now)
        return gpus, procs


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 11 — CPU  (total + per-core + frequency + temperature)
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class CpuInfo:
    """Extended CPU snapshot including per-core and temperature data."""
    total_pct:    float = 0.0
    per_core:     List[float] = field(default_factory=list)   # one entry per logical core
    freq_mhz:     float = 0.0   # current frequency of core 0 (or average)
    freq_max_mhz: float = 0.0
    temp_c:       float = 0.0   # package/die temperature, 0 if unavailable
    physical_cores: int = 0
    logical_cores:  int = 0


def _read_cpu_temp() -> float:
    """
    Try to read CPU package temperature cross-platform.
    Returns 0.0 when unavailable (macOS without sudo, most Windows configs).
    Priority:  psutil sensors → Linux /sys thermal zones → skip on other OS.
    """
    # psutil sensors_temperatures (Linux & some macOS with coretemp module)
    try:
        sensors = psutil.sensors_temperatures()
        if sensors:
            # Look for the most meaningful key in order of preference
            for key in ("coretemp", "k10temp", "zenpower", "cpu_thermal",
                        "acpitz", "soc_thermal", "Package id 0"):
                if key in sensors and sensors[key]:
                    # Use the package or max-label entry when available
                    entries = sensors[key]
                    pkg = next((e for e in entries
                                if "package" in e.label.lower() or e.label == ""), None)
                    return round((pkg or entries[0]).current, 1)
            # Fall through to first available sensor
            for entries in sensors.values():
                if entries:
                    return round(entries[0].current, 1)
    except AttributeError:
        pass   # sensors_temperatures not available on this OS/version
    except Exception as exc:
        log.debug("CPU temp (sensors): %s", exc)

    # Linux /sys thermal zone fallback
    if IS_LINUX:
        try:
            tz0 = Path("/sys/class/thermal/thermal_zone0/temp")
            if tz0.exists():
                raw = int(tz0.read_text().strip())
                return round(raw / 1000.0, 1)   # millidegrees → °C
        except Exception as exc:
            log.debug("CPU temp (/sys): %s", exc)

    # macOS — powermetrics requires root; skip silently
    # Windows — WMI MSAcpi_ThermalZoneTemperature requires elevated rights; skip
    return 0.0


def get_cpu() -> CpuInfo:
    """
    Collect total CPU %, per-core %, frequency, temperature, and core counts.
    Every sub-metric fails gracefully to 0 / empty list.
    """
    # ── Total + per-core ──────────────────────────────────────────────────────
    try:
        total_pct = psutil.cpu_percent(interval=None)
        per_core  = psutil.cpu_percent(interval=None, percpu=True) or []
    except Exception as exc:
        log.debug("cpu_percent: %s", exc)
        total_pct, per_core = 0.0, []

    # ── Frequency ─────────────────────────────────────────────────────────────
    freq_mhz = freq_max = 0.0
    try:
        freq = psutil.cpu_freq(percpu=False)
        if freq:
            freq_mhz = round(freq.current, 1)
            freq_max  = round(freq.max,     1)
    except Exception as exc:
        log.debug("cpu_freq: %s", exc)

    # ── Core counts ───────────────────────────────────────────────────────────
    try:
        phys = psutil.cpu_count(logical=False) or 0
        logi = psutil.cpu_count(logical=True)  or 0
    except Exception:
        phys = logi = 0

    return CpuInfo(
        total_pct=round(total_pct, 1),
        per_core=[round(v, 1) for v in per_core],
        freq_mhz=freq_mhz,
        freq_max_mhz=freq_max,
        temp_c=_read_cpu_temp(),
        physical_cores=phys,
        logical_cores=logi,
    )


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 12 — RAM  (virtual memory + swap)
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class RamInfo:
    """Virtual + swap memory snapshot."""
    total_mb:   int   = 0
    used_mb:    int   = 0
    avail_mb:   int   = 0
    used_pct:   float = 0.0
    swap_total: int   = 0    # MB
    swap_used:  int   = 0    # MB
    swap_pct:   float = 0.0


def get_ram() -> RamInfo:
    vm = RamInfo()
    try:
        m = psutil.virtual_memory()
        vm.total_mb  = m.total // 1024 ** 2
        vm.used_mb   = m.used  // 1024 ** 2
        vm.avail_mb  = m.available // 1024 ** 2
        vm.used_pct  = round(m.percent, 1)
    except Exception as exc:
        log.debug("virtual_memory: %s", exc)
    try:
        s = psutil.swap_memory()
        vm.swap_total = s.total // 1024 ** 2
        vm.swap_used  = s.used  // 1024 ** 2
        vm.swap_pct   = round(s.percent, 1)
    except Exception as exc:
        log.debug("swap_memory: %s", exc)
    return vm


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 13 — NETWORK
#
#  Interface selection priority:
#    1. User-configured NET_IFACE
#    2. Any "wifi"/"wlan"/"wi-fi"/"en0" style name that is up
#    3. Any non-loopback up interface
#    4. System total (pernic=False)
#
#  Wi-Fi extras (signal, SSID) are collected where available:
#    Linux  : /proc/net/wireless + iw/iwconfig
#    macOS  : airport CLI
#    Windows: netsh wlan show interfaces
# ══════════════════════════════════════════════════════════════════════════════

_net_prev: Optional[Tuple[Any, float]] = None


def _pick_iface() -> str:
    """Return the best interface name (empty = use system totals)."""
    if NET_IFACE:
        return NET_IFACE
    try:
        stats = psutil.net_if_stats()
        lo_names = {"lo", "loopback", "lo0"}

        # First prefer anything that looks like Wi-Fi
        wifi_hints = ("wlan", "wifi", "wi-fi", "wlp", "en0", "en1", "wl")
        for name, s in stats.items():
            if s.isup and name.lower() not in lo_names:
                if any(name.lower().startswith(h) for h in wifi_hints):
                    return name

        # Otherwise any non-loopback up interface
        for name, s in stats.items():
            if s.isup and name.lower() not in lo_names:
                return name
    except Exception as exc:
        log.debug("net iface pick: %s", exc)
    return ""


def _get_wifi_signal() -> Tuple[Optional[str], Optional[int]]:
    """
    Try to read SSID and signal strength (dBm or %).
    Returns (ssid_or_None, signal_int_or_None).
    Fails silently — this is purely cosmetic.
    """
    # Linux: /proc/net/wireless
    if IS_LINUX:
        try:
            txt = Path("/proc/net/wireless").read_text()
            for line in txt.splitlines()[2:]:
                parts = line.split()
                if len(parts) >= 4:
                    signal = int(float(parts[3].rstrip(".")))
                    return None, signal
        except Exception:
            pass
        # iw dev … link
        try:
            r = subprocess.run(["iw", "dev"], capture_output=True, text=True, timeout=2)
            iface = None
            for ln in r.stdout.splitlines():
                ln = ln.strip()
                if ln.startswith("Interface "):
                    iface = ln.split()[1]
            if iface:
                r2 = subprocess.run(["iw", iface, "link"],
                                    capture_output=True, text=True, timeout=2)
                ssid = signal = None
                for ln in r2.stdout.splitlines():
                    ln = ln.strip()
                    if ln.startswith("SSID:"):
                        ssid = ln.split(":", 1)[1].strip()
                    if "signal:" in ln:
                        signal = int(float(ln.split(":")[1].split()[0]))
                return ssid, signal
        except Exception:
            pass

    # macOS: airport
    if IS_MACOS:
        airport = ("/System/Library/PrivateFrameworks/Apple80211.framework"
                   "/Versions/Current/Resources/airport")
        try:
            r = subprocess.run([airport, "-I"],
                               capture_output=True, text=True, timeout=3)
            ssid = signal = None
            for ln in r.stdout.splitlines():
                ln = ln.strip()
                if ln.startswith("SSID:"):
                    ssid = ln.split(":", 1)[1].strip()
                if ln.startswith("agrCtlRSSI:"):
                    signal = int(ln.split(":")[1].strip())
            return ssid, signal
        except Exception:
            pass

    # Windows: netsh wlan show interfaces
    if IS_WINDOWS:
        try:
            r = subprocess.run(
                ["netsh", "wlan", "show", "interfaces"],
                capture_output=True, text=True, timeout=4, encoding="utf-8", errors="replace")
            ssid = signal = None
            for ln in r.stdout.splitlines():
                ln = ln.strip()
                if ln.startswith("SSID") and "BSSID" not in ln:
                    ssid = ln.split(":", 1)[1].strip()
                if ln.startswith("Signal"):
                    try:
                        signal = int(ln.split(":")[1].strip().rstrip("%"))
                    except Exception:
                        pass
            return ssid, signal
        except Exception:
            pass

    return None, None


@dataclass
class NetInfo:
    """Extended network info including Wi-Fi extras."""
    iface:       str   = ""
    speed_tx_kb: float = 0.0
    speed_rx_kb: float = 0.0
    bytes_sent:  int   = 0
    bytes_recv:  int   = 0
    err_in:      int   = 0
    err_out:     int   = 0
    ssid:        str   = ""          # empty if wired or unavailable
    signal_dbm:  Optional[int] = None  # None if unavailable
    # All up interfaces for the Wi-Fi tab details
    all_ifaces:  List[Dict[str, Any]] = field(default_factory=list)


def get_net() -> NetInfo:
    global _net_prev
    iface  = _pick_iface()
    result = NetInfo(iface=iface or "total")

    try:
        ctrs = psutil.net_io_counters(pernic=bool(iface))
        if isinstance(ctrs, dict):
            c = ctrs.get(iface) if iface else None
            if c is None and ctrs:
                c = next(iter(ctrs.values()), None)
        else:
            c = ctrs

        if c is not None:
            now = time.time()
            if _net_prev:
                pc, pt = _net_prev
                dt_s             = max(now - pt, 0.001)
                result.speed_tx_kb = max(0.0, round((c.bytes_sent - pc.bytes_sent) / dt_s / 1024, 1))
                result.speed_rx_kb = max(0.0, round((c.bytes_recv - pc.bytes_recv) / dt_s / 1024, 1))
            _net_prev           = (c, now)
            result.bytes_sent   = c.bytes_sent
            result.bytes_recv   = c.bytes_recv
            result.err_in       = getattr(c, "errin",  0)
            result.err_out      = getattr(c, "errout", 0)
    except Exception as exc:
        log.debug("net io counters: %s", exc)

    # All interfaces summary for tab detail
    try:
        all_stats  = psutil.net_if_stats()
        all_addrs  = psutil.net_if_addrs()
        all_ctrs   = psutil.net_io_counters(pernic=True) or {}
        lo = {"lo", "loopback", "lo0"}
        for name, s in all_stats.items():
            if name.lower() in lo:
                continue
            addr_list = all_addrs.get(name, [])
            ipv4 = next(
                (a.address for a in addr_list if a.family.name == "AF_INET"), "")
            ctr = all_ctrs.get(name)
            result.all_ifaces.append({
                "name":   name,
                "up":     s.isup,
                "speed":  s.speed,      # Mbps, 0 = unknown
                "ipv4":   ipv4,
                "sent_mb":  round(ctr.bytes_sent / 1024 ** 2, 1) if ctr else 0,
                "recv_mb":  round(ctr.bytes_recv / 1024 ** 2, 1) if ctr else 0,
            })
    except Exception as exc:
        log.debug("net all_ifaces: %s", exc)

    # Wi-Fi extras (best-effort, non-blocking)
    try:
        ssid, sig    = _get_wifi_signal()
        result.ssid       = ssid or ""
        result.signal_dbm = sig
    except Exception:
        pass

    return result


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 14 — DISK  (all mounted partitions + I/O rates)
# ══════════════════════════════════════════════════════════════════════════════

_disk_prev: Optional[Tuple[Any, float]] = None


@dataclass
class PartitionInfo:
    """Stats for one mounted filesystem partition."""
    device:     str   = ""
    mountpoint: str   = ""
    fstype:     str   = ""
    total_gb:   float = 0.0
    used_gb:    float = 0.0
    free_gb:    float = 0.0
    used_pct:   float = 0.0


@dataclass
class DiskInfo:
    """Aggregated disk stats: primary path + all partitions + I/O rates."""
    path:        str   = ""
    total_gb:    float = 0.0
    used_gb:     float = 0.0
    free_gb:     float = 0.0
    used_pct:    float = 0.0
    read_mb_s:   float = 0.0
    write_mb_s:  float = 0.0
    partitions:  List[PartitionInfo] = field(default_factory=list)


def _get_partitions() -> List[PartitionInfo]:
    """Return stats for every readable mounted partition."""
    parts: List[PartitionInfo] = []
    skip_fstypes = {
        "tmpfs", "devtmpfs", "proc", "sysfs", "cgroup", "cgroup2",
        "devfs", "debugfs", "securityfs", "pstore", "hugetlbfs",
        "mqueue", "fusectl", "configfs", "binfmt_misc",
    }
    try:
        for p in psutil.disk_partitions(all=False):
            if p.fstype.lower() in skip_fstypes:
                continue
            # Skip virtual Windows drives (CD-ROM etc.)
            if IS_WINDOWS and p.fstype == "":
                continue
            try:
                u = psutil.disk_usage(p.mountpoint)
                parts.append(PartitionInfo(
                    device=p.device,
                    mountpoint=p.mountpoint,
                    fstype=p.fstype,
                    total_gb=round(u.total / 1024 ** 3, 1),
                    used_gb=round(u.used  / 1024 ** 3, 1),
                    free_gb=round(u.free  / 1024 ** 3, 1),
                    used_pct=round(u.percent, 1),
                ))
            except (PermissionError, OSError):
                pass   # network mounts, encrypted volumes not yet unlocked, etc.
    except Exception as exc:
        log.debug("disk partitions: %s", exc)
    return parts


def get_disk() -> DiskInfo:
    global _disk_prev
    result = DiskInfo(path=DISK_PATH)

    # Primary path stats
    try:
        u = psutil.disk_usage(DISK_PATH)
        result.total_gb = round(u.total / 1024 ** 3, 1)
        result.used_gb  = round(u.used  / 1024 ** 3, 1)
        result.free_gb  = round(u.free  / 1024 ** 3, 1)
        result.used_pct = round(u.percent, 1)
    except Exception as exc:
        log.debug("disk_usage(%s): %s", DISK_PATH, exc)

    # System-wide I/O rates
    try:
        dc  = psutil.disk_io_counters(perdisk=False)
        now = time.time()
        if dc and _disk_prev:
            pc, pt = _disk_prev
            dt_s            = max(now - pt, 0.001)
            result.read_mb_s  = max(0.0, round((dc.read_bytes  - pc.read_bytes)  / dt_s / 1024 ** 2, 2))
            result.write_mb_s = max(0.0, round((dc.write_bytes - pc.write_bytes) / dt_s / 1024 ** 2, 2))
        if dc:
            _disk_prev = (dc, now)
    except Exception as exc:
        log.debug("disk_io_counters: %s", exc)

    # All partitions
    result.partitions = _get_partitions()
    return result



# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 15 -- PROCESS SCANNER  v3
#
#  Design goals
#  ============
#  Stable at 2 000+ processes on Windows (primary), Linux, and macOS.
#  Never crash: every OS call is individually guarded; inaccessible
#  processes are counted and debug-logged, never raised.
#
#  Core algorithm: prime → sleep → read
#  =====================================
#  psutil's cpu_percent(interval=None) works by computing the delta between
#  two successive calls on the *same Process object*.  Two calls separated by
#  at least PROC_PRIME_SLEEP (100 ms) produce an accurate reading.
#
#  Pass 1  process_iter with a minimal attrs list → prime cpu counters.
#  Sleep   PROC_PRIME_SLEEP so the OS accumulates CPU ticks.
#  Pass 2  Iterate cached handles → read cpu delta + RSS → aggregate.
#
#  Key design decisions
#  ====================
#  - Name caching in handle tuple: the name is resolved ONCE in pass-1 and
#    stored in the handle so pass-2 makes zero extra OS calls per process.
#  - PID-reuse safety: handles are keyed by PID; create_time is compared on
#    every pass-1 touch.  A recycled PID replaces the old handle immediately.
#  - Handle cap: _proc_handles is bounded to _HANDLE_CAP entries to prevent
#    unbounded RAM growth on systems with rapid process churn.
#  - Set-difference eviction: dead PIDs are found with a single O(n) set
#    difference, not an O(n) list comprehension + O(1) membership test.
#  - Windows specialties: PIDs 0 and 4 (System Idle / System) are harmless
#    but generate AccessDenied on some calls; they are caught silently.
#    STATUS_* constants are resolved with getattr so missing ones don't crash.
#  - GPU "unsupported" vs "0 usage": ProcEntry.gpu_supported is False when
#    no GPU backend is active, so callers can distinguish "no GPU" from "idle".
#  - Log rate limiting: the slow-scan warning is suppressed if it fires on
#    consecutive cycles to avoid flooding the log file.
#
#  Thread safety
#  =============
#  _proc_handles and _last_proc_scan are only written by the collector thread.
#  No lock is needed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Configuration constants ───────────────────────────────────────────────────

# Attributes fetched in a single process_iter call.
# Keep the list minimal: each extra attr adds a syscall per process on Linux.
_PROC_ATTRS: List[str] = [
    "pid", "name", "status", "cpu_percent", "memory_info", "create_time",
]

# Status strings that indicate a process is already dead and can be skipped.
# Built dynamically so missing constants on old psutil versions are safe.
_SKIP_STATUSES: frozenset = frozenset(
    s for s in (
        getattr(psutil, "STATUS_ZOMBIE",  None),
        getattr(psutil, "STATUS_DEAD",    None),
    )
    if s is not None
)

# PIDs that are always present on Windows and always raise AccessDenied for
# some calls.  We include them in stats but skip attribute queries for them.
_WINDOWS_SYSTEM_PIDS: frozenset = frozenset({0, 4})

# Hard cap on the handle cache size.  At 2 000 processes each handle is a
# lightweight Python object (~200 bytes), so 4 096 entries ≈ 800 KB max.
# When the cap is reached the LRU-style eviction keeps the most recently
# seen PIDs (live_pids) and drops any excess cached handles.
_HANDLE_CAP: int = 4096

# Slow-scan warning: only log once per this many consecutive slow cycles
# to avoid flooding the log file on a consistently loaded system.
_SLOW_WARN_EVERY: int = 10


# ── Handle cache ──────────────────────────────────────────────────────────────
# Tuple layout: (psutil.Process, create_time_float, cached_name_str)
# Storing the name here means pass-2 never calls p.name() or accesses p.info.
_ProcHandleTuple = Tuple["psutil.Process", float, str]
_proc_handles:   Dict[int, _ProcHandleTuple] = {}
_last_proc_scan: float = 0.0
_slow_warn_count: int  = 0   # consecutive slow scans (for rate-limiting)


# ── GPU availability flag ─────────────────────────────────────────────────────
def _gpu_active() -> bool:
    """Return True when any GPU backend has been detected."""
    return bool(_gpu_backend)


# ══════════════════════════════════════════════════════════════════════════════
#  ScannerStats  —  per-cycle telemetry attached to every Snapshot
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class ScannerStats:
    """
    Lightweight diagnostics emitted every scan cycle.
    Attached to Snapshot.scan_stats for dashboard display and debug.
    """
    total_seen:      int   = 0    # PIDs returned by process_iter
    skipped_access:  int   = 0    # AccessDenied / ZombieProcess
    skipped_gone:    int   = 0    # NoSuchProcess (race-condition exits)
    skipped_status:  int   = 0    # zombie / dead status at scan time
    skipped_system:  int   = 0    # Windows system PIDs (0, 4)
    new_handles:     int   = 0    # freshly created or refreshed handles
    recycled_pids:   int   = 0    # handles replaced due to PID reuse
    aggregated:      int   = 0    # duplicate names merged (instances > 1)
    handles_cached:  int   = 0    # live handle count after eviction
    unique_names:    int   = 0    # distinct process names in result
    scan_ms:         float = 0.0  # wall-clock duration (ms)
    gpu_supported:   bool  = False  # whether GPU backend was active


_last_stats: ScannerStats = ScannerStats()


def get_scanner_stats() -> ScannerStats:
    """Return a copy of the most recent scan telemetry (safe to call anytime)."""
    return ScannerStats(**vars(_last_stats))


# ══════════════════════════════════════════════════════════════════════════════
#  Safe attribute helpers
#  Each function returns a clean default on ANY error so the main loops stay
#  completely flat — no nested try/except required at the call site.
# ══════════════════════════════════════════════════════════════════════════════

def _safe_name(p: "psutil.Process", info: Dict[str, Any]) -> str:
    """
    Resolve a display name from a process_iter info dict.

    Resolution order:
      1. info["name"]  — already fetched, zero extra cost
      2. p.name()      — direct call fallback (may raise)
      3. "Unknown"     — when all else fails

    On Windows, strips .exe suffix so "chrome.exe" groups with "chrome"
    across 32-bit / 64-bit variants that may appear differently.
    The strip is lowercase-safe: "CHROME.EXE" and "chrome.exe" both match.
    """
    raw = (info.get("name") or "").strip()
    if not raw:
        try:
            raw = (p.name() or "").strip()
        except (psutil.NoSuchProcess, psutil.AccessDenied, OSError):
            return "Unknown"
    if IS_WINDOWS and len(raw) > 4 and raw[-4:].lower() == ".exe":
        raw = raw[:-4]
    return raw or "Unknown"


def _safe_create_time(p: "psutil.Process", info: Dict[str, Any]) -> float:
    """
    Return the process creation timestamp (Unix epoch float).
    Falls back to a direct p.create_time() call if info is empty.
    Returns 0.0 on any failure; the caller treats 0.0 as "always refresh".
    """
    try:
        ct = info.get("create_time")
        if ct is not None:
            return float(ct)
        return float(p.create_time())
    except (psutil.NoSuchProcess, psutil.AccessDenied, ValueError, OSError):
        return 0.0


def _safe_mem_mb(p: "psutil.Process") -> float:
    """
    Read RSS in MB from a cached Process handle.
    Tries memory_info() first; on failure returns 0.0 without raising.
    MemoryError is included because some platforms return absurd values
    that cause int overflow in the conversion.
    """
    try:
        mi = p.memory_info()
        if mi is None:
            return 0.0
        rss = mi.rss
        if not isinstance(rss, int) or rss < 0:
            return 0.0
        return round(rss / 1_048_576, 1)   # 1_048_576 = 1024**2
    except (psutil.NoSuchProcess, psutil.AccessDenied,
            psutil.ZombieProcess, OSError, OverflowError, MemoryError):
        return 0.0


def _safe_cpu_read(p: "psutil.Process") -> float:
    """
    Read the cpu_percent delta since the last call on this handle.
    Returns 0.0 on any error.  Never blocks (interval=None).
    """
    try:
        val = p.cpu_percent(None)
        if val is None or val < 0:
            return 0.0
        # Clamp to a sanity ceiling: 100% * logical cores
        # (psutil can return >100 on multi-core systems by design)
        return round(float(val), 2)
    except (psutil.NoSuchProcess, psutil.AccessDenied,
            psutil.ZombieProcess, OSError, ValueError):
        return 0.0


def _safe_prime_cpu(p: "psutil.Process") -> None:
    """
    Call cpu_percent(None) once to start/reset the measurement window.
    All errors are silently swallowed; a failed prime just means cpu=0
    in the next pass, which is the safe fallback.
    """
    try:
        p.cpu_percent(None)
    except (psutil.NoSuchProcess, psutil.AccessDenied,
            psutil.ZombieProcess, OSError):
        pass


# ══════════════════════════════════════════════════════════════════════════════
#  _scan_procs  —  the core scanner
# ══════════════════════════════════════════════════════════════════════════════

def _scan_procs(gpu_procs: Dict[str, int]) -> Tuple[Dict[str, ProcEntry], ScannerStats]:
    """
    Full process scan.  Returns (aggregated_dict, scan_stats).

    aggregated_dict  Dict[name, ProcEntry]  one entry per unique process name
    scan_stats       ScannerStats           per-cycle diagnostics

    Two-pass algorithm
    ------------------
    Pass 1  (process_iter with _PROC_ATTRS)
            For each process in the OS process table:
              a. Check status — skip zombie/dead immediately.
              b. Skip Windows system PIDs (0, 4) that always deny.
              c. Resolve create_time for PID-reuse detection.
              d. Resolve and cache the display name.
              e. Store/refresh the handle in _proc_handles.
              f. Prime the CPU counter (_safe_prime_cpu).
            Each step (c-f) is independently guarded so a failure in one
            does not affect any other process or the loop continuation.

    Evict   Dead PIDs are removed from _proc_handles in a single pass using
            set difference (O(n), no temporary list).

    Sleep   PROC_PRIME_SLEEP seconds so the OS accumulates CPU ticks.

    Pass 2  For each cached handle:
              a. Read CPU delta (_safe_cpu_read — never blocks).
              b. Read RSS in MB (_safe_mem_mb — never blocks).
              c. Retrieve the cached name (zero OS calls).
              d. Aggregate into result dict (sum CPU + RAM per name).
            Processes that exited between pass-1 and pass-2 are evicted
            silently and counted in stats.skipped_gone.

    GPU     Inject VRAM MB from gpu_procs after the scan.
            gpu_procs is always a plain dict (possibly empty).
            When no GPU backend is active, gpu_mb stays 0 for all entries
            and ProcEntry.gpu_supported is set to False.
    """
    global _proc_handles, _last_stats, _slow_warn_count

    stats    = ScannerStats(gpu_supported=_gpu_active())
    t0       = time.monotonic()
    live_pids: set = set()

    # =========================================================================
    #  Pass 1: enumerate processes, prime CPU counters
    # =========================================================================
    try:
        for p in psutil.process_iter(_PROC_ATTRS):
            # ── Outer guard: catches any error process_iter emits per-entry ──
            try:
                info = p.info   # pre-fetched dict; may have partial data
                pid  = p.pid
                stats.total_seen += 1

                # (a) Status check — skip dead/zombie without an extra syscall
                status = (info.get("status") or "").strip()
                if status in _SKIP_STATUSES:
                    stats.skipped_status += 1
                    continue

                # (b) Windows system PID guard
                if IS_WINDOWS and pid in _WINDOWS_SYSTEM_PIDS:
                    stats.skipped_system += 1
                    live_pids.add(pid)   # keep in live set to prevent churn
                    continue

                live_pids.add(pid)

                # (c) PID-reuse detection via create_time
                ct     = _safe_create_time(p, info)
                cached = _proc_handles.get(pid)

                if cached is None:
                    # Brand-new PID
                    name = _safe_name(p, info)
                    _proc_handles[pid] = (p, ct, name)
                    stats.new_handles += 1
                elif cached[1] != ct:
                    # Same PID, different create_time → recycled PID
                    name = _safe_name(p, info)
                    _proc_handles[pid] = (p, ct, name)
                    stats.recycled_pids += 1
                    stats.new_handles   += 1
                # else: existing, valid handle — no update needed

                # (f) Prime the CPU counter (independent guard)
                _safe_prime_cpu(_proc_handles[pid][0])

            except psutil.NoSuchProcess:
                stats.skipped_gone += 1
            except (psutil.AccessDenied, psutil.ZombieProcess):
                stats.skipped_access += 1
            except OSError:
                stats.skipped_access += 1
            except Exception as exc:
                # Truly unexpected per-process error — log once and continue
                log.debug("proc scan pass-1 pid=%s: %s",
                          getattr(p, "pid", "?"), exc)

    except Exception as exc:
        # process_iter itself failed (e.g. /proc unmounted on Linux)
        log.debug("proc scan pass-1 iter: %s", exc)

    # =========================================================================
    #  Evict dead handles using set difference (O(n), no list comprehension)
    # =========================================================================
    dead_pids = _proc_handles.keys() - live_pids
    for pid in dead_pids:
        del _proc_handles[pid]

    # Enforce handle cap to prevent unbounded memory growth on systems with
    # rapid process churn.  When over cap, keep only the live PIDs we just saw.
    if len(_proc_handles) > _HANDLE_CAP:
        excess = set(_proc_handles.keys()) - live_pids
        for pid in list(excess)[: len(_proc_handles) - _HANDLE_CAP]:
            _proc_handles.pop(pid, None)
        log.debug("proc handle cap hit: evicted %d extra handles.", len(dead_pids))

    stats.handles_cached = len(_proc_handles)

    # =========================================================================
    #  Sleep: CPU measurement window
    # =========================================================================
    time.sleep(PROC_PRIME_SLEEP)

    # =========================================================================
    #  Pass 2: read metrics, aggregate by name
    # =========================================================================
    result: Dict[str, ProcEntry] = {}
    gpu_flag = stats.gpu_supported

    for pid, handle_tuple in list(_proc_handles.items()):
        # Unpack tuple: (Process, create_time, cached_name)
        # The name is resolved once in pass-1 and stored here — zero OS calls.
        try:
            p, _ct, name = handle_tuple
        except (TypeError, ValueError):
            # Malformed entry (should never happen) — skip and evict
            _proc_handles.pop(pid, None)
            continue

        try:
            cpu    = _safe_cpu_read(p)
            mem_mb = _safe_mem_mb(p)

            if name in result:
                entry           = result[name]
                entry.cpu       = round(entry.cpu    + cpu,    2)
                entry.mem_mb    = round(entry.mem_mb + mem_mb, 1)
                entry.instances += 1
                stats.aggregated += 1
            else:
                result[name] = ProcEntry(
                    pid           = pid,
                    cpu           = cpu,
                    mem_mb        = mem_mb,
                    gpu_mb        = 0,
                    gpu_supported = gpu_flag,
                    instances     = 1,
                )

        except psutil.NoSuchProcess:
            # Process exited between pass-1 and pass-2 — evict silently
            _proc_handles.pop(pid, None)
            stats.skipped_gone += 1
        except (psutil.AccessDenied, psutil.ZombieProcess):
            stats.skipped_access += 1
        except OSError:
            stats.skipped_access += 1
        except Exception as exc:
            log.debug("proc scan pass-2 pid=%d: %s", pid, exc)

    stats.unique_names = len(result)

    # =========================================================================
    #  GPU VRAM injection
    #
    #  gpu_procs maps process name -> VRAM MB and is populated only when a
    #  GPU backend with per-process visibility is active (pynvml / nvidia-smi).
    #  On all other platforms and GPU backends it is an empty dict, making
    #  this loop a no-op.  gpu_mb=0 with gpu_supported=False clearly signals
    #  "GPU monitoring not available" to the dashboard.
    # =========================================================================
    if gpu_flag and gpu_procs:
        for gname, vram_mb in gpu_procs.items():
            if gname in result:
                result[gname].gpu_mb = _safe_int(vram_mb)

    # =========================================================================
    #  Finalise stats and slow-scan rate-limited warning
    # =========================================================================
    stats.scan_ms = round((time.monotonic() - t0) * 1000, 1)

    if stats.scan_ms > 500:
        _slow_warn_count += 1
        if _slow_warn_count % _SLOW_WARN_EVERY == 1:
            log.debug(
                "Slow proc scan #%d: %.0f ms | seen=%d unique=%d handles=%d "
                "new=%d recycled=%d skipped(access=%d gone=%d status=%d system=%d)",
                _slow_warn_count, stats.scan_ms,
                stats.total_seen, stats.unique_names, stats.handles_cached,
                stats.new_handles, stats.recycled_pids,
                stats.skipped_access, stats.skipped_gone,
                stats.skipped_status, stats.skipped_system,
            )
    else:
        _slow_warn_count = 0   # reset consecutive count on a fast scan

    _last_stats = stats
    return result, stats


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 16 -- COLLECTOR  (assembles one complete Snapshot per cycle)
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class Snapshot:
    """One complete data point collected per INTERVAL_SEC."""
    ts:          str
    cpu:         "CpuInfo"
    ram:         "RamInfo"
    gpus:        "List[GpuInfo]"
    procs:       Dict[str, ProcEntry]
    net:         "NetInfo"
    disk:        "DiskInfo"
    gpu_procs:   Dict[str, int]           # process name -> GPU VRAM MB
    scan_stats:  ScannerStats = field(default_factory=ScannerStats)


def collect(prev: Dict[str, ProcEntry]) -> Snapshot:
    """
    Gather all hardware metrics and return a Snapshot.

    Execution order
    ===============
    1. Prime the system-wide CPU counter (no sleep yet).
    2. Fetch GPU data early so gpu_procs is ready before the proc scan.
    3. Decide whether a proc scan is due (time-based throttle).
       - Due:     run _scan_procs() which sleeps PROC_PRIME_SLEEP internally.
       - Not due: sleep PROC_PRIME_SLEEP directly to keep the system CPU
                  measurement window consistent across all cycles.
    4. Read system CPU + RAM AFTER the sleep (accurate delta window).
    5. Read net + disk (fast; no sleep dependency).
    6. Fire log warnings for threshold crossings.

    The prev dict is returned unchanged on non-scan cycles so the dashboard
    always shows the most recent process data without stale-zeroing.
    """
    global _last_proc_scan

    # 1. Prime system CPU counter before any sleep
    try:
        psutil.cpu_percent(interval=None)
    except Exception:
        pass

    # 2. GPU — early fetch so gpu_procs is ready for proc scan injection
    try:
        gpus, gpu_procs = get_gpu()
    except Exception as exc:
        log.debug("collect get_gpu: %s", exc)
        gpus, gpu_procs = [], {}

    # 3. Process scan — time-throttled by PROC_SCAN_INTERVAL seconds
    now     = time.time()
    do_scan = (now - _last_proc_scan) >= PROC_SCAN_INTERVAL

    if do_scan:
        try:
            procs, scan_stats = _scan_procs(gpu_procs)
        except Exception as exc:
            # _scan_procs is already heavily guarded, but catch any
            # top-level failure and reuse the previous snapshot safely
            log.error("_scan_procs failed: %s\n%s", exc, traceback.format_exc())
            procs, scan_stats = prev, _last_stats
        _last_proc_scan = time.time()
    else:
        # No scan this cycle — sleep for a consistent CPU window
        time.sleep(PROC_PRIME_SLEEP)
        procs      = prev
        scan_stats = _last_stats

    # 4. System metrics — read AFTER the sleep for an accurate CPU delta
    try:
        cpu = get_cpu()
    except Exception as exc:
        log.debug("collect get_cpu: %s", exc)
        cpu = CpuInfo()

    try:
        ram = get_ram()
    except Exception as exc:
        log.debug("collect get_ram: %s", exc)
        ram = RamInfo()

    # 5. Network and disk
    try:
        net = get_net()
    except Exception as exc:
        log.debug("collect get_net: %s", exc)
        net = NetInfo()

    try:
        disk = get_disk()
    except Exception as exc:
        log.debug("collect get_disk: %s", exc)
        disk = DiskInfo()

    # 6. Threshold alerts
    if cpu.total_pct >= ALERT_CPU:
        log.warning("CPU HIGH: %.1f%% (threshold %.0f%%)", cpu.total_pct, ALERT_CPU)
    if ram.used_pct >= ALERT_RAM:
        log.warning("RAM HIGH: %.1f%% (threshold %.0f%%)", ram.used_pct, ALERT_RAM)

    return Snapshot(
        ts         = dt.datetime.now().strftime("%Y-%m-%dT%H:%M:%S"),
        cpu        = cpu,
        ram        = ram,
        gpus       = gpus,
        procs      = procs,
        net        = net,
        disk       = disk,
        gpu_procs  = gpu_procs,
        scan_stats = scan_stats,
    )


