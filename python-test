        all_p = conn.execute(
            "SELECT name,pid,cpu_pct,mem_mb,gpu_mb,instances FROM procs "
            "WHERE snap_id=? ORDER BY name COLLATE NOCASE",
            (snap_id,)).fetchall()

        def _rng(vals: List) -> List[float]:
            v = [x for x in vals if x is not None]
            if not v:
