@dataclass
class GpuInfo:
    """GPU metrics for a single device."""
    name:      str   = ""
    load_pct:  float = 0.0
    mem_used:  int   = 0    # MB
    mem_total: int   = 0    # MB
    mem_pct:   float = 0.0
    temp_c:    float = 0.0


@dataclass
class ProcEntry:
    """
    Aggregated metrics for all processes sharing the same name.

    Fields are always present with safe defaults so downstream code never
    needs to guard against missing keys.

    cpu / mem_mb are summed across all instances sharing the same name.
    gpu_mb is 0 when the GPU backend has no VRAM data for this process.
    gpu_supported reflects whether any GPU backend is active at all; when
    False the caller knows gpu_mb=0 means "unsupported", not "idle".
    """
    pid:           int   = 0     # representative PID (first seen)
    cpu:           float = 0.0   # total CPU % summed across instances
    mem_mb:        float = 0.0   # total RSS MB summed across instances
    gpu_mb:        int   = 0     # VRAM MB (0 = none used or unsupported)
    gpu_supported: bool  = False # True when a GPU backend is active
    instances:     int   = 1     # count of processes with this name
    status:        str   = ""    # last known status string (informational)


@dataclass
class NetStats:
    """Network I/O snapshot for one interface (or system total)."""
    iface:       str   = ""
    speed_tx_kb: float = 0.0   # KB/s since last reading
    speed_rx_kb: float = 0.0
    bytes_sent:  int   = 0     # cumulative counters
    bytes_recv:  int   = 0
    err_in:      int   = 0
    err_out:     int   = 0


