#  Called by the renderer thread before writing data.json.
# ══════════════════════════════════════════════════════════════════════════════

def build_data(conn: sqlite3.Connection, sid: int) -> Optional[Dict[str, Any]]:
    cached = _cache.get("data")
    if cached:
        return cached
    try:
        row = conn.execute(
            "SELECT id,ts,cpu_pct,cpu_freq,cpu_temp,"
            "ram_pct,ram_used,ram_total,swap_pct,"
            "gpu0_load,gpu0_mem_pct,gpu0_temp,"
            "net_tx_kb,net_rx_kb,disk_pct,disk_rd_mbs,disk_wr_mbs,proc_count "
            "FROM snapshots WHERE session_id=? ORDER BY id DESC LIMIT 1",
            (sid,)).fetchone()
        if not row:
            return None

        (snap_id, ts,
         cpu_pct, cpu_freq, cpu_temp,
         ram_pct, ram_used, ram_tot, swap_pct,
         g_load, g_mem, g_temp,
         net_tx, net_rx,
         d_pct, d_rd, d_wr, pc) = row

        hist = list(reversed(conn.execute(
            "SELECT ts,cpu_pct,ram_pct,gpu0_load,"
            "net_tx_kb,net_rx_kb,disk_pct,disk_rd_mbs,disk_wr_mbs,cpu_temp,cpu_freq "
            "FROM snapshots WHERE session_id=? ORDER BY id DESC LIMIT ?",
            (sid, CHART_POINTS)).fetchall()))

        sr = conn.execute(
            "SELECT MAX(cpu_pct),AVG(cpu_pct),"
            "MAX(ram_pct),AVG(ram_pct),"
            "MAX(gpu0_load),MAX(net_tx_kb),MAX(net_rx_kb),COUNT(*) "
            "FROM snapshots WHERE session_id=?", (sid,)).fetchone()
        mk_cpu, av_cpu, mk_ram, av_ram, mk_gpu, mk_tx, mk_rx, total = sr

        sess = conn.execute(
            "SELECT user,host,os,py,started_at FROM sessions WHERE id=?",
            (sid,)).fetchone()
        user, host, os_str, pyver, started = sess

        uptime = 0
        try:
            uptime = int((dt.datetime.now() -
                          dt.datetime.fromisoformat(started)).total_seconds())
        except Exception:
            pass

        top_cpu = conn.execute(
