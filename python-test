_DEFAULTS: Dict[str, Any] = {k: v[0] for k, v in _SCHEMA.items()}


def _coerce(key: str, raw: Any) -> Any:
    """
    Coerce *raw* to the expected type for *key* and clamp to [min, max].
    Returns the schema default on any failure; logs a warning.
    """
    default, coerce_type, lo, hi, _ = _SCHEMA[key]
    try:
        if coerce_type is bool:
            val: Any = (raw if isinstance(raw, bool)
                        else str(raw).lower() in ("1", "true", "yes", "on"))
        else:
            val = coerce_type(raw)
        if lo is not None and val < lo:
            log.warning("Config '%s': %r < min %r — clamped to %r.", key, val, lo, lo)
            val = lo
        if hi is not None and val > hi:
            log.warning("Config '%s': %r > max %r — clamped to %r.", key, val, hi, hi)
            val = hi
        return val
    except (ValueError, TypeError) as exc:
        log.warning("Config '%s': cannot coerce %r (%s) — using default %r.",
                    key, raw, exc, default)
        return default


def _write_default_config() -> None:
    """Write an annotated default config.json using atomic write."""
    output: Dict[str, Any] = {
        "_help":    {k: v[4] for k, v in _SCHEMA.items()},
        "_version": _DEFAULTS["config_version"],
    }
    output.update(_DEFAULTS)
    content = json.dumps(output, indent=2, ensure_ascii=False)
    if _atomic_write_text(_CFG_PATH, content):
        log.info("Default config written: %s", _CFG_PATH)
    else:
        log.warning("Cannot write default config to %s — using in-memory defaults.", _CFG_PATH)


def _load_cfg() -> Dict[str, Any]:
    cfg = dict(_DEFAULTS)

    if not _CFG_PATH.exists():
        _write_default_config()
        log.info("First run — using default configuration.")
        return cfg

    # Read
    try:
        raw_text = _CFG_PATH.read_text(encoding="utf-8")
    except OSError as exc:
        log.warning("Cannot read config (%s) — using defaults.", exc)
        return cfg

    # Parse
    try:
        raw = json.loads(raw_text)
    except json.JSONDecodeError as exc:
        log.warning(
            "Config JSON error at line %d col %d: %s — using defaults.",
            exc.lineno, exc.colno, exc.msg,
        )
        return cfg

    if not isinstance(raw, dict):
        log.warning("Config is not a JSON object — using defaults.")
        return cfg

    # Version check
    file_ver = raw.get("config_version", raw.get("_version", 1))
    schema_ver = _DEFAULTS["config_version"]
    if isinstance(file_ver, int) and file_ver < schema_ver:
        log.info(
            "Config version %d < current %d — new keys will use defaults.",
            file_ver, schema_ver,
        )

    # Apply
    applied = 0
    for key in _SCHEMA:
        if key in raw:
            cfg[key] = _coerce(key, raw[key])
            applied += 1

    unknown = [k for k in raw
               if k not in _SCHEMA and not k.startswith("_")]
    if unknown:
        log.debug("Config: %d unknown key(s) ignored: %s",
                  len(unknown), ", ".join(unknown))

    log.info("Config loaded (%d/%d keys applied, version %s).",
             applied, len(_SCHEMA), file_ver)
    return cfg


CFG: Dict[str, Any] = _load_cfg()

