# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 17 -- DATABASE
#
#  WAL + NORMAL sync + mmap give the best write throughput for our workload
#  (append-heavy, no concurrent writers, one reader).
#  busy_timeout=5000 prevents lock errors when the dashboard JS reader
#  holds a read transaction slightly longer than expected.
#
#  Batch write buffer
#  ==================
#  Rows are staged in _db_buffer (capped at _DB_BUFFER_CAP entries).
#  A flush happens every COMMIT_EVERY cycles, wrapping all rows in a
#  single BEGIN/COMMIT.  On flush failure the rows are written to a
#  recovery JSON file so no data is permanently lost.
#  flush_db_buffer() is the public shutdown hook.
# ══════════════════════════════════════════════════════════════════════════════

_DB_BUFFER_CAP: int = 100   # hard cap; prevents unbounded growth on flush failure


def _pragmas(conn: sqlite3.Connection) -> None:
    conn.executescript("""
        PRAGMA journal_mode  = WAL;
        PRAGMA synchronous   = NORMAL;
        PRAGMA foreign_keys  = ON;
        PRAGMA cache_size    = -8000;
        PRAGMA busy_timeout  = 5000;
        PRAGMA temp_store    = MEMORY;
        PRAGMA mmap_size     = 268435456;
    """)


def _wal_checkpoint(conn: sqlite3.Connection) -> None:
    """Passive WAL checkpoint — runs in background, never blocks."""
    try:
        conn.execute("PRAGMA wal_checkpoint(PASSIVE);")
    except Exception as exc:
        log.debug("WAL checkpoint: %s", exc)


def init_db(conn: sqlite3.Connection) -> None:
    try:
        _pragmas(conn)
        conn.executescript("""
            CREATE TABLE IF NOT EXISTS sessions(
                id         INTEGER PRIMARY KEY AUTOINCREMENT,
                user       TEXT, host TEXT, os TEXT, py TEXT,
                started_at TEXT DEFAULT(strftime('%Y-%m-%dT%H:%M:%S','now','localtime')));

            CREATE TABLE IF NOT EXISTS snapshots(
                id         INTEGER PRIMARY KEY AUTOINCREMENT,
                session_id INTEGER NOT NULL REFERENCES sessions(id),
                ts         TEXT,
                cpu_pct    REAL, cpu_freq REAL, cpu_temp REAL,
                ram_pct    REAL, ram_used INTEGER, ram_total INTEGER,
                swap_pct   REAL,
                gpu0_load  REAL, gpu0_mem_pct REAL, gpu0_temp REAL,
                net_tx_kb  REAL, net_rx_kb    REAL,
                disk_pct   REAL, disk_rd_mbs  REAL, disk_wr_mbs REAL,
                proc_count INTEGER);

            CREATE TABLE IF NOT EXISTS procs(
                id        INTEGER PRIMARY KEY AUTOINCREMENT,
                snap_id   INTEGER NOT NULL REFERENCES snapshots(id),
                name      TEXT, pid INTEGER,
                cpu_pct   REAL, mem_mb REAL, gpu_mb INTEGER, instances INTEGER);

            CREATE INDEX IF NOT EXISTS idx_snap_sess ON snapshots(session_id, id);
            CREATE INDEX IF NOT EXISTS idx_proc_snap ON procs(snap_id);
            CREATE INDEX IF NOT EXISTS idx_proc_name ON procs(name);
        """)
        conn.commit()
    except Exception as exc:
        _die(f"DB init failed: {exc}\n{traceback.format_exc()}")


def start_session(conn: sqlite3.Connection) -> int:
    import getpass, socket
    try:    user = getpass.getuser()
    except: user = os.environ.get("USERNAME", os.environ.get("USER", "?"))
    try:    host = socket.gethostname()
    except: host = "?"
    cur = conn.execute(
        "INSERT INTO sessions(user,host,os,py) VALUES(?,?,?,?)",
        (user, host, platform.platform(), sys.version.split()[0]))
    conn.commit()
    log.info("Session started: %s@%s", user, host)
    return cur.lastrowid


def prune(conn: sqlite3.Connection, sid: int) -> None:
    """Delete the oldest snapshots to keep the DB within MAX_SNAPSHOTS rows."""
    try:
        n = conn.execute(
            "SELECT COUNT(*) FROM snapshots WHERE session_id=?", (sid,)
        ).fetchone()[0]
        if n <= MAX_SNAPSHOTS:
            return
        rm = n - MAX_SNAPSHOTS
        # SQLite max variables = 999; chunk if needed
        chunk = 900
        offset = 0
        deleted = 0
        while deleted < rm:
            count = min(chunk, rm - deleted)
            ids = [r[0] for r in conn.execute(
                "SELECT id FROM snapshots WHERE session_id=? "
                "ORDER BY id ASC LIMIT ? OFFSET ?",
                (sid, count, offset)).fetchall()]
            if not ids:
                break
            ph = ",".join("?" * len(ids))
            conn.execute(f"DELETE FROM procs     WHERE snap_id IN ({ph})", ids)
            conn.execute(f"DELETE FROM snapshots WHERE id      IN ({ph})", ids)
            conn.commit()
            deleted += len(ids)
        log.debug("Pruned %d old snapshots.", deleted)
    except Exception as exc:
        log.error("Prune failed: %s\n%s", exc, traceback.format_exc())


# ─────────────────────────────────────────────────────────────────────────────
#  Batch write buffer
# ─────────────────────────────────────────────────────────────────────────────

@dataclass
class _PendingRow:
    """One snapshot row + its proc rows, waiting to be committed."""
    snap_vals: tuple
    proc_rows: List[tuple]


_db_buffer:       List[_PendingRow] = []
_db_flush_fails:  int = 0            # consecutive flush failures
_RECOVERY_PATH:   Path = _DIR_CACHE / "db_recovery.json"


def write_snap(conn: sqlite3.Connection, sid: int,
               s: "Snapshot", cycle: int) -> Optional[int]:
    """
    Stage one snapshot into the write buffer.
    Flushes to SQLite every COMMIT_EVERY cycles.
    When the buffer reaches _DB_BUFFER_CAP, forces an immediate flush
    regardless of cycle count to prevent unbounded RAM growth.
    """
    global _db_buffer

    g0    = s.gpus[0] if s.gpus else GpuInfo()
    has_g = bool(s.gpus)

    snap_vals = (
        sid, s.ts,
        s.cpu.total_pct, s.cpu.freq_mhz, s.cpu.temp_c,
        s.ram.used_pct,  s.ram.used_mb,  s.ram.total_mb, s.ram.swap_pct,
        g0.load_pct  if has_g else None,
        g0.mem_pct   if has_g else None,
        g0.temp_c    if has_g else None,
        s.net.speed_tx_kb, s.net.speed_rx_kb,
        s.disk.used_pct,   s.disk.read_mb_s,  s.disk.write_mb_s,
        len(s.procs),
    )
    proc_rows = [
        (nm, e.pid, e.cpu, e.mem_mb, e.gpu_mb, e.instances)
        for nm, e in s.procs.items()
    ]
    _db_buffer.append(_PendingRow(snap_vals=snap_vals, proc_rows=proc_rows))

    # Force flush when cap is reached to prevent unbounded growth
    force = len(_db_buffer) >= _DB_BUFFER_CAP
    if force or (cycle % COMMIT_EVERY == 0):
        if force:
            log.debug("DB buffer cap hit (%d rows) — forcing flush.", len(_db_buffer))
        return _flush_db_buffer(conn)
    return None


def _flush_db_buffer(conn: sqlite3.Connection) -> Optional[int]:
    """
    Commit all buffered rows in a single transaction.

    On failure:
      - Rows are written to a recovery JSON file so they survive a crash
      - _db_flush_fails counter is incremented for health tracking
      - Buffer is cleared regardless so it cannot grow without bound
    Returns the last inserted snap_id, or None on empty/error.
    """
    global _db_buffer, _db_flush_fails

    if not _db_buffer:
        return None

    rows_to_flush = _db_buffer
    _db_buffer    = []
    last_snap_id: Optional[int] = None

    try:
        with conn:   # BEGIN ... COMMIT (or ROLLBACK on exception)
            for row in rows_to_flush:
                cur = conn.execute(
                    "INSERT INTO snapshots"
                    "(session_id,ts,cpu_pct,cpu_freq,cpu_temp,"
                    " ram_pct,ram_used,ram_total,swap_pct,"
                    " gpu0_load,gpu0_mem_pct,gpu0_temp,"
                    " net_tx_kb,net_rx_kb,disk_pct,disk_rd_mbs,disk_wr_mbs,proc_count)"
                    " VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                    row.snap_vals,
                )
                snap_id      = cur.lastrowid
                last_snap_id = snap_id
                conn.executemany(
                    "INSERT INTO procs(snap_id,name,pid,cpu_pct,mem_mb,gpu_mb,instances)"
                    " VALUES(?,?,?,?,?,?,?)",
                    [(snap_id, r[0], r[1], r[2], r[3], r[4], r[5])
                     for r in row.proc_rows],
                )
        _cache.drop("data")
        _db_flush_fails = 0
        log.debug("DB flush: committed %d row(s).", len(rows_to_flush))
        storage_health.record_success()

    except Exception as exc:
        _db_flush_fails += 1
        log.error(
            "DB flush failed (attempt %d, %d rows): %s\n%s",
            _db_flush_fails, len(rows_to_flush), exc, traceback.format_exc(),
        )
        storage_health.record_failure()
        # Persist rows to recovery file so they survive a crash
        _write_db_recovery(rows_to_flush)
        return None

    return last_snap_id


def _write_db_recovery(rows: List[_PendingRow]) -> None:
    """
    Write buffered rows to a recovery JSON file when the DB flush fails.
    The recovery file accumulates across failures and is read on next startup.
    This prevents data loss on temporary disk issues.
    """
    try:
        existing: List[Dict] = []
        if _RECOVERY_PATH.exists():
            try:
                existing = json.loads(_RECOVERY_PATH.read_text(encoding="utf-8"))
                if not isinstance(existing, list):
                    existing = []
            except Exception:
                existing = []

        new_entries = [
            {"snap": list(r.snap_vals), "procs": r.proc_rows}
            for r in rows
        ]
        combined = existing + new_entries
        _atomic_write_text(
            _RECOVERY_PATH,
            json.dumps(combined, ensure_ascii=False, default=str),
        )
        log.warning("DB recovery: %d row(s) saved to %s", len(rows), _RECOVERY_PATH)
    except Exception as exc:
        log.debug("DB recovery write failed: %s", exc)


def flush_db_buffer(conn: sqlite3.Connection) -> None:
    """Public flush hook — call on graceful shutdown to drain the buffer."""
    _flush_db_buffer(conn)
    # Also run a WAL checkpoint so the DB file is compact on next open
    _wal_checkpoint(conn)


