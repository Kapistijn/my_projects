                           "mem_mb": r[3] or 0, "gpu_mb": r[4] or 0,
                           "inst": r[5] or 1} for r in all_p],
            "procs":  pc or 0,
            "snaps":  total or 0,
            "uptime": uptime,
            "history": [
                {
                    "ts":   r[0][11:19],
                    "cpu":  round(r[1] or 0, 1),
                    "ram":  round(r[2] or 0, 1),
                    "gpu":  round(r[3] or 0, 1) if r[3] is not None else None,
                    "tx":   round(r[4] or 0, 1),
                    "rx":   round(r[5] or 0, 1),
                    "dpct": round(r[6] or 0, 1),
                    "drd":  round(r[7] or 0, 2),
                    "dwr":  round(r[8] or 0, 2),
                    "temp": round(r[9]  or 0, 1) if r[9]  else None,
                    "freq": round(r[10] or 0, 0) if r[10] else None,
                }
                for r in hist
            ],
            "ranges": {
                "cpu":  _rng([r[1] for r in hist]),
                "ram":  _rng([r[2] for r in hist]),
                "gpu":  _rng([r[3] for r in hist]),
                "net":  [0.0, round(net_peak, 1)],
                "disk": _rng([r[6] for r in hist]),
            },
        }
        _cache.set("data", result)
        return result

    except Exception as exc:
        log.error("build_data: %s\n%s", exc, traceback.format_exc())
        return None


def enrich_live(data: Dict[str, Any], snap: "Snapshot") -> None:
    """
    Inject non-DB live fields from the latest Snapshot.
    Uses targeted key updates instead of dict.update to avoid accidentally
    clobbering DB-sourced values if key names ever overlap.
    """
    # Network
    try:
        n = snap.net
        data["net"]["iface"]      = n.iface
        data["net"]["ssid"]       = n.ssid
        data["net"]["signal_dbm"] = n.signal_dbm
        data["net"]["all_ifaces"] = n.all_ifaces
    except Exception as exc:
        log.debug("enrich_live net: %s", exc)

    # Disk partitions + live usage
    try:
        d = snap.disk
        data["disk"]["total_gb"]   = d.total_gb
        data["disk"]["used_gb"]    = d.used_gb
        data["disk"]["free_gb"]    = d.free_gb
        data["disk"]["partitions"] = [
            {
                "device":     p.device,
                "mountpoint": p.mountpoint,
                "fstype":     p.fstype,
                "total_gb":   p.total_gb,
                "used_gb":    p.used_gb,
                "free_gb":    p.free_gb,
                "used_pct":   p.used_pct,
            }
            for p in d.partitions
        ]
    except Exception as exc:
        log.debug("enrich_live disk: %s", exc)

    # CPU per-core + live freq/temp
    try:
        data["cpu"]["per_core"] = snap.cpu.per_core
        data["cpu"]["freq_mhz"] = snap.cpu.freq_mhz
        data["cpu"]["temp_c"]   = snap.cpu.temp_c
        data["cpu"]["phys"]     = snap.cpu.physical_cores
        data["cpu"]["logi"]     = snap.cpu.logical_cores
    except Exception as exc:
        log.debug("enrich_live cpu: %s", exc)

    # RAM swap detail
    try:
        data["ram"]["swap_total_mb"] = snap.ram.swap_total
        data["ram"]["swap_used_mb"]  = snap.ram.swap_used
        data["ram"]["avail_mb"]      = snap.ram.avail_mb
    except Exception as exc:
        log.debug("enrich_live ram: %s", exc)

    # Live storage health status
    try:
        data["session"]["storage_ok"]    = storage_health.is_healthy()
        data["session"]["disk_free_mb"]  = round(storage_health.available_mb(), 1)
    except Exception:
        pass


# ══════════════════════════════════════════════════════════════════════════════
#  SECTION 19 -- DATA.JSON WRITER + SNAPSHOT RING + EXPORT + SPA HTML
#
#  Four storage surfaces
#  =====================
#  A. data.json        Live SPA feed; delta-guarded, compact JSON, no indent
#  B. Snapshot ring    Timestamped files in data/snapshots/; gzip optional;
#                      auto-pruned to SNAPSHOT_KEEP; history excluded to save space
#  C. Export           On-demand full CSV + JSON in data/exports/
#  D. dashboard.html   Written once at startup via write_spa_html()
#
#  All writes go through _atomic_write_text/_bytes (write-tmp-then-replace).
#  StorageHealth gates writes: if is_healthy() is False, skips are logged.
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
#  A. data.json — delta-guarded live feed
#
#  Delta sentinel covers: cpu, ram, gpu, procs, disk_pct, net_tx
#  so any meaningful metric change triggers a write.
#  Compact JSON (no indent, no spaces) reduces file size by ~40%.
# ─────────────────────────────────────────────────────────────────────────────

_last_data_sig: str = ""   # signature of last written payload


def _build_data_sig(data: Dict[str, Any]) -> str:
    """
    Build a compact change-detection signature from the most volatile fields.
    If this signature is identical to the last write, the write is skipped.
    """
    try:
        cpu     = round(float(data.get("cpu",  {}).get("now",    0)), 1)
        ram     = round(float(data.get("ram",  {}).get("pct",    0)), 1)
        gpu     = round(float(data.get("gpu",  {}).get("load") or 0), 1)
        procs   = int(        data.get("procs",  0))
        snaps   = int(        data.get("snaps",  0))
        disk    = round(float(data.get("disk",  {}).get("used_pct", 0)), 1)
        net_tx  = round(float(data.get("net",   {}).get("tx_kb",  0)), 1)
        return f"{cpu}|{ram}|{gpu}|{procs}|{snaps}|{disk}|{net_tx}"
    except Exception:
        return ""   # empty sig → always write


def write_json_data(data: Dict[str, Any]) -> bool:
    """
    Atomically write the live data.json payload to data/cache/.

    Delta guard: computes a multi-metric signature; if nothing meaningful
    changed since the last write, the write is skipped to reduce disk I/O.
    Storage health gate: if the disk is critically full, skips the write.

    Returns True when a write was performed, False when skipped or failed.
    """
    global _last_data_sig

    if not storage_health.is_healthy():
        log.debug("write_json_data skipped: storage unhealthy.")
        return False

    sig = _build_data_sig(data)
    if sig and sig == _last_data_sig:
        return False   # nothing meaningful changed

    try:
        payload = json.dumps(data, ensure_ascii=False, separators=(",", ":"))
    except Exception as exc:
        log.debug("write_json_data serialise: %s", exc)
        return False

    dest = Path(JSON_DATA_PATH)
    if _atomic_write_text(dest, payload):
        _last_data_sig = sig
        storage_health.record_success()
        return True

    storage_health.record_failure()
    return False


# ─────────────────────────────────────────────────────────────────────────────
#  B. Snapshot ring — timestamped JSON files in data/snapshots/
#
#  Filename encodes the timestamp for lexicographic ordering:
#    snap_20250714T223105_000042.json[.gz]
#    (timestamp + monotonic counter prevents collisions on fast cycles)
#  Ring is pruned automatically after every write.
#  Both .json and .json.gz are handled when listing/pruning so changing
#  snapshot_compress mid-run doesn't leave orphan files invisible.
# ─────────────────────────────────────────────────────────────────────────────

_snap_seq: int = 0   # monotonic sequence counter for unique filenames


def _snapshot_filename(ts: str) -> str:
    """
    Build a sortable, unique snapshot filename.
    '2025-07-14T22:31:05' + seq=42 → 'snap_20250714T223105_000042.json[.gz]'
    """
    global _snap_seq
    _snap_seq += 1
    safe = ts.replace(":", "").replace("-", "").replace(" ", "T")
    ext  = ".json.gz" if SNAPSHOT_COMPRESS else ".json"
    return f"snap_{safe}_{_snap_seq:06d}{ext}"


def write_snapshot_file(data: Dict[str, Any]) -> Optional[Path]:
    """
    Write one snapshot to the ring directory.
    Excludes the 'history' array (already in DB) to reduce file size.
    Returns the written Path on success, None on failure.
    Auto-prunes the ring after each write.
    """
    if not storage_health.is_healthy():
        return None

    ts   = data.get("ts", dt.datetime.now().strftime("%Y-%m-%dT%H:%M:%S"))
    name = _snapshot_filename(ts)
    dest = _DIR_SNAPSHOTS / name

    try:
        # Slim payload: omit 'history' (verbose, already persisted in DB)
        slim = {k: v for k, v in data.items() if k != "history"}
        raw  = json.dumps(slim, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        body = gzip.compress(raw, compresslevel=6) if SNAPSHOT_COMPRESS else raw

        if _atomic_write_bytes(dest, body):
            storage_health.record_success()
            _prune_snapshot_ring()
            return dest
        storage_health.record_failure()
    except Exception as exc:
        log.debug("write_snapshot_file %s: %s", name, exc)
    return None


def _prune_snapshot_ring() -> None:
    """
    Delete oldest snapshot files when the ring exceeds SNAPSHOT_KEEP.
    Globs BOTH .json and .json.gz so mixed-mode rings prune correctly
    (e.g. after changing snapshot_compress in config).
    """
    try:
        files = sorted(
            list(_DIR_SNAPSHOTS.glob("snap_*.json")) +
            list(_DIR_SNAPSHOTS.glob("snap_*.json.gz"))
        )
        excess = len(files) - SNAPSHOT_KEEP
        if excess <= 0:
            return
        for old in files[:excess]:
            try:
                old.unlink()
            except OSError as exc:
                log.debug("prune snapshot %s: %s", old.name, exc)
        log.debug("Snapshot ring pruned %d file(s) (kept %d).", excess, SNAPSHOT_KEEP)
    except Exception as exc:
        log.debug("_prune_snapshot_ring: %s", exc)


def read_snapshot_file(path: Path) -> Optional[Dict[str, Any]]:
    """
    Read and decompress a snapshot file.
    Supports both .json and .json.gz regardless of current SNAPSHOT_COMPRESS.
    Returns None on any error.
    """
    try:
        raw = path.read_bytes()
        # Detect gzip by magic bytes (1f 8b) rather than extension
        if raw[:2] == b"\x1f\x8b":
            raw = gzip.decompress(raw)
        return json.loads(raw.decode("utf-8"))
    except Exception as exc:
        log.debug("read_snapshot_file %s: %s", path.name, exc)
        return None


def list_snapshots() -> List[Path]:
    """
    Return all snapshot files sorted oldest-first.
    Handles both .json and .json.gz so listing is always complete.
    """
    try:
        return sorted(
            list(_DIR_SNAPSHOTS.glob("snap_*.json")) +
            list(_DIR_SNAPSHOTS.glob("snap_*.json.gz"))
        )
    except Exception:
        return []


def get_snapshot_ring_stats() -> Dict[str, Any]:
    """Return a summary of the snapshot ring for dashboard/debug use."""
    files = list_snapshots()
    total_bytes = 0
    for f in files:
        try:
            total_bytes += f.stat().st_size
        except OSError:
            pass
    return {
        "count":        len(files),
        "keep":         SNAPSHOT_KEEP,
        "compressed":   SNAPSHOT_COMPRESS,
        "total_kb":     round(total_bytes / 1024, 1),
        "oldest":       files[0].name  if files else None,
        "newest":       files[-1].name if files else None,
    }


# ─────────────────────────────────────────────────────────────────────────────
#  C. Export — on-demand CSV + JSON in data/exports/
# ─────────────────────────────────────────────────────────────────────────────

def do_export(conn: sqlite3.Connection, sid: int) -> Tuple[str, str]:
    """
    Write a full session export to data/exports/ and return (csv_path, json_path).
    Uses atomic writes; logs errors but always returns valid path strings
    so the caller can display them regardless of whether writes succeeded.
    JSON is capped at EXPORT_JSON_MAX_ROWS (most recent rows) to stay manageable.
    """
    ts    = dt.datetime.now().strftime("%Y%m%d_%H%M%S")
    csv_p = _DIR_EXPORTS / f"snapshots_{ts}.csv"
    jso_p = _DIR_EXPORTS / f"snapshots_{ts}.json"

    cols = [
        "ts", "cpu_pct", "ram_pct", "ram_used_mb", "ram_total_mb",
        "gpu0_load", "net_tx_kb", "net_rx_kb", "disk_pct",
        "disk_rd_mbs", "disk_wr_mbs", "cpu_temp_c", "cpu_freq_mhz",
        "swap_pct", "proc_count",
    ]

    # DB query
    try:
        rows = conn.execute(
            "SELECT ts,cpu_pct,ram_pct,ram_used,ram_total,"
            "gpu0_load,net_tx_kb,net_rx_kb,disk_pct,disk_rd_mbs,disk_wr_mbs,"
            "cpu_temp,cpu_freq,swap_pct,proc_count "
            "FROM snapshots WHERE session_id=? ORDER BY id ASC", (sid,)
        ).fetchall()
    except Exception as exc:
        log.error("Export DB query failed: %s", exc)
        return str(csv_p), str(jso_p)

    # CSV — build in memory, write atomically
    buf = _io.StringIO()
    w   = csv.writer(buf)
    w.writerow(cols)
    w.writerows(rows)
    ok_csv = _atomic_write_text(csv_p, buf.getvalue())
    if ok_csv:
        storage_health.record_success()

    # JSON — cap rows, write atomically
    tail = rows[-EXPORT_JSON_MAX_ROWS:]
    ok_json = _atomic_write_text(
        jso_p,
        json.dumps(
            [dict(zip(cols, r)) for r in tail],
            indent=2, ensure_ascii=False,
        ),
    )
    if ok_json:
        storage_health.record_success()

    log.info(
        "Export: %s rows total, %d in JSON, csv=%s json=%s",
        len(rows), len(tail),
        "OK" if ok_csv else "FAIL", "OK" if ok_json else "FAIL",
    )
    return str(csv_p), str(jso_p)


# ─────────────────────────────────────────────────────────────────────────────
#  D. SPA HTML shell — written once at startup
# ─────────────────────────────────────────────────────────────────────────────

def write_spa_html() -> None:
    """
    Render and atomically write the SPA HTML shell to data/cache/.
    The live dashboard data is served by data.json; this file is static.
    Skips re-writing if the file already exists with the correct interval.
    """
    dest = Path(HTML_PATH)
    html = _SPA_HTML.replace("__INTERVAL__", str(INTERVAL_SEC))

    # Skip if file is already up-to-date (avoids unnecessary write on restart)
    try:
        if dest.exists() and f"setInterval(poll, {INTERVAL_SEC}" in dest.read_text(encoding="utf-8"):
            log.debug("SPA dashboard already current — skipping write.")
            return
    except OSError:
        pass

    if _atomic_write_text(dest, html):
        log.info("SPA dashboard written: %s", dest)
        storage_health.record_success()
    else:
        log.error("Failed to write SPA dashboard: %s", dest)
        storage_health.record_failure()

